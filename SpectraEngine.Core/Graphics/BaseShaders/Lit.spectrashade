// Lit.spectrashade — the engine's built-in lit shader.
// Diffuse + ambient shading from a single directional light.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 worldNormal;
}

struct FragmentInput {
    vec3 worldNormal;
}

shader Lit {
    [Binding(0)] cbuffer Transforms {
        mat4 uModel;
        mat4 uView;
        mat4 uProjection;
    }

    [Binding(1)] cbuffer Lighting {
        vec3 uLightDir;
        vec3 uBaseColor;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * uModel * vec4(input.position, 1.0);
        output.worldNormal = mat3(uModel) * input.normal;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec3 n = Math.Normalize(input.worldNormal);
        float ndotl = Math.Max(Math.Dot(n, Math.Normalize(-uLightDir)), 0.0);
        vec3 ambient = uBaseColor * 0.2;
        vec3 diffuse = uBaseColor * ndotl;
        return vec4(ambient + diffuse, 1.0);
    }
}
