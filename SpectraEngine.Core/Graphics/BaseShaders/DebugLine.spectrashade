// DebugLine.spectrashade — unlit per-vertex-coloured shader for debug primitives
// (wireframes, AABBs, normals, crosses). Position and colour come in per
// vertex; no model matrix, all primitives are pushed in world space.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 color;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 color;
}

struct FragmentInput {
    vec3 color;
}

shader DebugLine {
    [Binding(0)] cbuffer Camera {
        mat4 uView;
        mat4 uProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * vec4(input.position, 1.0);
        output.color = input.color;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        return vec4(input.color, 1.0);
    }
}
