// DeferredLight.spectrashade — the deferred light pass.
//
// Reads the G-buffer and shades it with a Cook-Torrance microfacet BRDF: GGX
// for the normal distribution, Smith height-correlated for visibility, Schlick
// for Fresnel. This is the step that turns the roughness and metallic channels
// from stored bytes into an actual surface response; before it, the engine's
// lighting was albedo times N dot L, with no specular term of any kind.
//
// World position is RECONSTRUCTED from depth rather than read from a G-buffer
// channel. The pixel's clip-space xy comes down from the vertex shader, the
// depth buffer gives z, and one inverse view-projection multiply gives the
// world point. That saves a whole RGBA16F attachment for something already
// written.
//
// Radiance accumulates over a uniform array of lights, which caps them. That is
// a stepping stone: the deferred answer is a bounding volume drawn per light
// with additive blending, which removes the cap entirely and needs no storage
// buffers. It needs blend state, which no backend implements yet.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;

    // Clip-space xy, carried down rather than derived from uv in the fragment
    // shader. THE TWO ARE NOT THE SAME MAPPING ON BOTH BACKENDS: the
    // full-screen triangle bakes a V flip into its vertex data on D3D, because
    // a render target's origin is top-left there and bottom-left on GL. So uv
    // is correct for SAMPLING the G-buffer on both, and reconstructing clip y
    // from it would be upside down on exactly one of them, with nothing
    // reporting an error. Interpolating the clip position itself is the same
    // number on both by construction.
    vec2 ndc;
}

struct FragmentInput {
    vec2 uv;
    vec2 ndc;
}

shader DeferredLight {
    [Binding(0)] cbuffer Frame {
        mat4 uInverseViewProjection;

        vec3 uCameraPosition;
        float uAmbient;

        // HEMISPHERE ambient: what the surface sees looking up, and looking
        // down. A flat scalar - which is what this was - lights a floor and a
        // ceiling identically, so nothing in an unlit corner has any shape at
        // all; it is the cheapest single thing that makes a scene read as being
        // lit by a PLACE rather than by a number. Two uniforms and one mix,
        // against an irradiance probe's cubemap and a convolution pass.
        //
        // The two are chosen so their average luminance is one, which is what
        // lets uAmbient keep meaning exactly what it meant before: the strength,
        // tuned once for the whole demo.
        vec3 uAmbientSky;
        vec3 uAmbientGround;

        // What the sky is, for the pixels no geometry wrote. A full-screen
        // triangle covers every pixel, so the light pass cannot leave the
        // background alone the way a forward pass does: it has to put the
        // clear colour back deliberately.
        vec3 uSkyColor;
        int uLightCount;

        // Turns a sampled depth texel into this backend's NDC z: (2, -1) where
        // clip z runs -1..1 and (1, 0) where it runs 0..1. A depth BUFFER
        // always stores 0..1, so on OpenGL the two disagree, and taking the
        // texel as NDC directly puts every reconstructed position in the wrong
        // half of the frustum.
        vec2 uDepthToNdc;

        // The pass's pixel size. Only the shadow filter uses it, to recover a
        // pixel coordinate from uv and dither its tap rotation with it.
        vec2 uTargetSize;

        // The G-BUFFER's pixel size, which is NOT uTargetSize: the G-buffer is
        // sized to the window and this pass may be running into a target of some
        // other size (an offscreen probe, a preview). See FragmentMain.
        vec2 uGBufferSize;

        // uv to clip-space xy for this backend, as (scale.xy, bias.xy). The two
        // differ by a V flip that FullscreenTriangle bakes into its vertices, so
        // the mapping cannot be assumed here - deriving ndc from uv with the
        // wrong sign renders one backend upside down and reports nothing.
        vec4 uUvToNdc;

        // Which light in the array the shadow map was rendered for, or -1 when
        // nothing casts this frame. One caster today; an index rather than a
        // flag because the second one costs a second map and not a rewrite.
        int uShadowLightIndex;

        // How many cascades were fitted this frame.
        int uCascadeCount;

        // 0 disables shadowing entirely, 1 is fully dark in shadow. Anything
        // between fakes the bounce light that an ambient term this crude cannot
        // provide, which is why it is exposed rather than hardcoded to 1.
        float uShadowStrength;

        // One texel in a CASCADE's own 0..1 space: the filter kernel's step.
        float uShadowTexel;

        // A small constant off the compared depth, against depth-buffer
        // quantisation. SMALL, because the acne it used to fight is fixed at
        // raster time now (see DepthBias) rather than here.
        float uShadowDepthBias;

        // Radius of the PCF tap circle, in texels of the chosen cascade.
        float uShadowFilterRadius;
    }

    // FOUR parallel vec4 arrays, never a struct array: a struct array
    // generates valid-looking text and then silently does nothing on OpenGL.
    // Four is also the minimum - an area light's bitangent is recovered by a
    // cross product rather than stored.
    //
    //   uLightPositions  xyz position or travel direction   w range
    //   uLightColors     rgb colour * intensity             w TYPE
    //   uLightAxis       xyz facing                         w cos(outer) | halfHeight | radius
    //   uLightTangent    xyz in-plane right                 w cos(inner) | halfWidth
    //
    // The type numbers are RenderLightType and are append-only: inserting a
    // value renumbers every kind after it and lights the wrong shape with no
    // error anywhere.
    [Binding(1)] cbuffer Lights {
        vec4[8] uLightPositions;
        vec4[8] uLightColors;
        vec4[8] uLightAxis;
        vec4[8] uLightTangent;
    }

    [Binding(2)] cbuffer Shadows {
        // World position to a lookup in one cascade's OWN 0..1 space. Every
        // convention difference between the backends is folded into these on the
        // CPU (see ShadowMap.WorldToShadow), so nothing here has to know which
        // way up a render target is.
        mat4[4] uWorldToShadow;

        // Per cascade: the atlas quadrant as (u, v, scale), and that cascade's
        // world texel size in w. The bias reads w because a texel of the far
        // cascade is many times the size of a near one, and one global offset
        // would either do nothing out there or eat every near shadow whole.
        vec4[4] uCascadeRects;
    }

    [Binding(0)] sampler2D uAlbedoAo;
    [Binding(1)] sampler2D uNormalRoughness;
    [Binding(2)] sampler2D uMaterialData;
    [Binding(3)] sampler2D uEmissive;
    [Binding(4)] sampler2D uDepth;
    [Binding(5)] sampler2D uShadowMap;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = vec4(input.position, 1.0);
        output.uv = input.uv;
        output.ndc = input.position.xy;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        // ONE G-BUFFER SAMPLE PER PIXEL, AND ITS OWN NDC WITH IT.
        //
        // The G-buffer is sized to the window and deliberately never follows the
        // frame target, so this pass can be wider or narrower than the surfaces
        // it reads. When it is, several pixels fall on one depth texel: each
        // brought its own interpolated clip-space xy, and reconstructing with
        // that against a depth measured somewhere else puts the world position
        // on THIS pixel's ray at THAT pixel's distance. The point slides along
        // the surface, which is invisible on anything facing the camera and
        // several times the real error on anything grazing - it made a lone
        // sphere self-shadow by 369 of 765 at a 96 probe against a 64 G-buffer,
        // where a matched pair reads 45.
        //
        // Snapping to the texel centre makes the depth and the ray describe the
        // same sample again. It is exactly a no-op when the sizes match, since
        // uv is then already (i + 0.5) / size, which is why the matched path
        // cannot be disturbed by this.
        vec2 texel = Math.Floor(input.uv * uGBufferSize) + vec2(0.5, 0.5);
        vec2 uv = texel / uGBufferSize;
        vec2 ndc = uv * uUvToNdc.xy + uUvToNdc.zw;

        float depth = uDepth.Sample(uv).r;

        // Nothing was drawn here. Shading it would read a zeroed normal against
        // a zeroed albedo, which is black rather than sky.
        if (depth >= 1.0) {
            return vec4(uSkyColor, 1.0);
        }

        vec4 albedoAo = uAlbedoAo.Sample(uv);
        vec4 normalRoughness = uNormalRoughness.Sample(uv);
        vec4 materialData = uMaterialData.Sample(uv);

        vec3 albedo = albedoAo.rgb;
        float ao = albedoAo.a;
        vec3 n = Math.Normalize(normalRoughness.rgb);

        // Clamped away from zero: a perfectly smooth surface makes the GGX
        // denominator vanish and the highlight becomes an infinity that shows
        // up as a single blinding pixel.
        float roughness = Math.Max(normalRoughness.a, 0.04);
        float metallic = materialData.r;

        vec3 worldPosition = ReconstructWorldPosition(ndc, depth);
        vec3 v = Math.Normalize(uCameraPosition - worldPosition);

        // Dielectrics reflect about 4% at normal incidence; metals have no
        // diffuse response at all and tint their reflection with the albedo.
        // One lerp expresses both, which is the whole of the metallic workflow.
        vec3 f0 = Math.Mix(vec3(0.04, 0.04, 0.04), albedo, metallic);
        vec3 diffuseColor = albedo * (1.0 - metallic);

        // n.y remapped to 0..1: straight up takes the sky, straight down the
        // ground, and a wall gets the average - which is the whole of the
        // approximation and the reason it costs one mix.
        vec3 ambient = Math.Mix(uAmbientGround, uAmbientSky, n.y * 0.5 + 0.5);
        vec3 total = diffuseColor * ambient * uAmbient * ao;

        for (int i = 0; i < uLightCount; i = i + 1) {
            vec4 posRange = uLightPositions[i];
            vec4 colorType = uLightColors[i];
            vec4 axis = uLightAxis[i];
            vec4 tangent = uLightTangent[i];

            vec3 radiance = colorType.rgb;
            float type = colorType.w;

            vec3 l = -posRange.xyz;
            float attenuation = 1.0;

            if (type > 0.5) {
                // The point the surface is actually lit FROM. For a point and a
                // spot that is the light's own origin; for an area light it is
                // the representative point - the spot on the shape closest to
                // the reflection of the view ray, which is the standard cheap
                // stand-in for integrating over the surface. LTC would be more
                // faithful and needs two lookup textures and a data-dependent
                // clipping loop, which is exactly what fxc refuses to compile.
                vec3 source = posRange.xyz;

                if (type > 2.5) {
                    source = AreaPoint(posRange.xyz, axis, tangent, type, worldPosition, n, v, roughness);
                }

                vec3 offset = source - worldPosition;
                float distance = Math.Length(offset);
                l = offset / Math.Max(distance, 0.0001);

                // Measured from the shape's CLOSEST point, not its centre.
                // Without this a four-unit panel goes dark at its own ends,
                // because the surface directly beneath a corner is two units
                // from the middle and the falloff does not know why.
                float window = Math.Max(1.0 - distance / posRange.w, 0.0);
                attenuation = window * window / (1.0 + distance * distance);

                if (type > 1.5) {
                    if (type < 2.5) {
                        attenuation = attenuation * SpotFactor(axis, tangent, l);
                    } else {
                        // ONE-SIDED. A panel emits from its front face only, and
                        // without this a ceiling light also lights the room
                        // above it - which is invisible from below and wrong
                        // everywhere else.
                        attenuation = attenuation * Math.Max(Math.Dot(axis.xyz, -l), 0.0);
                    }
                }
            }

            l = Math.Normalize(l);

            float shadow = 1.0;
            if (i == uShadowLightIndex) {
                shadow = ShadowFactor(worldPosition, input.uv * uTargetSize);
            }

            total = total + Shade(n, v, l, diffuseColor, f0, roughness) * radiance * attenuation * shadow;
        }

        // Emissive is added after shading, never lit: a surface that emits does
        // not also receive its own light.
        return vec4(total + uEmissive.Sample(uv).rgb, 1.0);
    }

    // A spot's cone falloff: full strength inside the inner half-angle, zero
    // outside the outer one, smoothed between. The comparison is against
    // COSINES, computed on the CPU once per frame, because converting to an
    // angle per pixel would put a transcendental in the inner loop for a value
    // that does not change.
    //
    // -l because l points from the surface TOWARD the light, and the cone axis
    // points the way the light travels. Getting this backwards lights a cone
    // pointing exactly opposite to the one drawn over it in the viewport.
    float SpotFactor(vec4 axis, vec4 tangent, vec3 l) {
        float cosAngle = Math.Dot(axis.xyz, -l);
        float outer = axis.w;
        float inner = tangent.w;

        // Max, not a bare subtraction: the CPU clamps inner to outer, and a
        // zero denominator here would be a division by zero rather than a hard
        // edge.
        float t = (cosAngle - outer) / Math.Max(inner - outer, 0.0001);
        t = Math.Clamp(t, 0.0, 1.0);

        // Squared, so the rim fades rather than stepping. A linear ramp reads
        // as a visible band at the cone's edge.
        return t * t;
    }

    // The representative point on an area light: the point on the shape closest
    // to where the view ray reflects off this surface.
    //
    // ONE point for both diffuse and specular here, which is the honest
    // simplification. Separate points are more faithful - the diffuse response
    // wants the shape's centroid and the specular wants the reflection - but a
    // second Shade call per light is a second full BRDF evaluation, and this
    // path already carries the frame's whole lighting cost. The visible
    // difference is confined to a tight highlight on a smooth surface.
    vec3 AreaPoint(vec3 center, vec4 axis, vec4 tangent, float type, vec3 world, vec3 n, vec3 v, float roughness) {
        vec3 r = Math.Reflect(-v, n);

        // Where the reflection ray meets the light's plane. A ray parallel to
        // the plane, or pointing away from it, has no useful intersection and
        // falls back to the centre - which is the point light this shape
        // degrades to, and the right answer for a surface that cannot see a
        // specular highlight on it at all.
        float denom = Math.Dot(r, axis.xyz);
        if (Math.Abs(denom) < 0.0001) {
            return center;
        }

        float t = Math.Dot(center - world, axis.xyz) / denom;
        if (t < 0.0) {
            return center;
        }

        vec3 hit = world + r * t;
        vec3 local = hit - center;

        // The bitangent is a cross product rather than a fourth uploaded
        // vector: the axis and the tangent are orthonormal by construction, so
        // it carries no information they do not already.
        vec3 bitangent = Math.Cross(axis.xyz, tangent.xyz);

        float u = Math.Dot(local, tangent.xyz);
        float vv = Math.Dot(local, bitangent);

        if (type > 3.5) {
            // A disc: clamp the offset's LENGTH rather than its components.
            float radius = axis.w;
            float len = Math.Sqrt(u * u + vv * vv);
            float scale = Math.Min(len, radius) / Math.Max(len, 0.0001);
            u = u * scale;
            vv = vv * scale;
        } else {
            // A rect: clamp each axis to its own half extent.
            u = Math.Clamp(u, -tangent.w, tangent.w);
            vv = Math.Clamp(vv, -axis.w, axis.w);
        }

        return center + tangent.xyz * u + bitangent * vv;
    }

    // One texel of the chosen cascade, compared. Clamped inside the cascade
    // BEFORE the atlas offset: a tap that walked off the edge of one quadrant
    // would land in the next cascade's and read a different projection.
    float CompareTexel(vec2 texel, vec4 rect, float reference) {
        vec2 local = Math.Clamp(texel * uShadowTexel, vec2(0.0, 0.0), vec2(1.0, 1.0));
        return Math.Step(reference, uShadowMap.Sample(rect.xy + local * rect.z).r);
    }

    // One shadow comparison, bilinearly weighted across the four texels the
    // sample falls between. The comparison happens per texel and the RESULTS are
    // blended; blending the depths instead would average two distances into one
    // that lies on neither surface.
    float CompareBilinear(vec2 local, vec4 rect, float reference) {
        vec2 texels = local / uShadowTexel;
        vec2 corner = Math.Floor(texels - vec2(0.5, 0.5)) + vec2(0.5, 0.5);
        vec2 weight = texels - corner;

        float s00 = CompareTexel(corner + vec2(0.0, 0.0), rect, reference);
        float s10 = CompareTexel(corner + vec2(1.0, 0.0), rect, reference);
        float s01 = CompareTexel(corner + vec2(0.0, 1.0), rect, reference);
        float s11 = CompareTexel(corner + vec2(1.0, 1.0), rect, reference);

        return Math.Mix(Math.Mix(s00, s10, weight.x), Math.Mix(s01, s11, weight.x), weight.y);
    }

    // Clip space back to world space. ndc is already -1..1 across the screen;
    // depth is 0..1 out of the buffer and needs this backend's remap.
    vec3 ReconstructWorldPosition(vec2 ndc, float depth) {
        vec4 clip = vec4(ndc.x, ndc.y, depth * uDepthToNdc.x + uDepthToNdc.y, 1.0);
        vec4 world = uInverseViewProjection * clip;
        return world.xyz / world.w;
    }

    // How much of this light reaches the point: 1 fully lit, 0 fully shadowed.
    float ShadowFactor(vec3 worldPosition, vec2 pixel) {
        if (uShadowStrength <= 0.0) {
            return 1.0;
        }

        // Pick the sharpest cascade that contains this point. The near ones are
        // small and are tested first, so most of the screen resolves on the
        // first iteration; a point past the last cascade falls out of the loop
        // unchosen and is simply lit, which is the shadow distance showing
        // itself honestly rather than as a hard black edge.
        int chosen = -1;
        for (int k = 0; k < uCascadeCount; k = k + 1) {
            if (chosen < 0) {
                vec4 probe = uWorldToShadow[k] * vec4(worldPosition, 1.0);
                vec3 p = probe.xyz / probe.w;
                float inside = Math.Step(0.0, p.x) * Math.Step(p.x, 1.0)
                             * Math.Step(0.0, p.y) * Math.Step(p.y, 1.0)
                             * Math.Step(p.z, 1.0);
                if (inside > 0.0) {
                    chosen = k;
                }
            }
        }

        if (chosen < 0) {
            return 1.0;
        }

        vec4 rect = uCascadeRects[chosen];

        // NO NORMAL OFFSET. There was one, scaled by tan of the angle between
        // the surface and the light and clamped at eight, and removing it is
        // most of what this shader gained. It existed to stop acne, which it
        // did by pushing the sample up to twelve texels off its own surface;
        // since the push is along the NORMAL, the shadow slid several
        // centimetres sideways, by a DIFFERENT amount on every face, so a
        // shadow crossing a corner visibly failed to meet itself. The depth
        // pass now biases each caster by its own depth slope at raster time,
        // which is the same fix applied to the actual cause and does not move
        // the shadow at all. See DepthBias.
        vec4 coords = uWorldToShadow[chosen] * vec4(worldPosition, 1.0);
        vec3 s = coords.xyz / coords.w;

        float reference = s.z - uShadowDepthBias;

        // FOUR TAPS ON A CIRCLE, ROTATED PER PIXEL. Each is bilinearly
        // weighted, so sixteen fetches, measured at 7.01 ms/frame at 1080p on
        // an Intel UHD 770.
        //
        // The weighting is what lets a tap answer "where inside this texel does
        // the edge fall" rather than only "is this texel's centre shadowed",
        // which is what a hardware comparison sampler does for free and what
        // this engine cannot ask for, because SpectraShade has no
        // sampler2DShadow.
        //
        // The ROTATION is the part that matters here, and it is nearly free.
        //
        // What is left after the bias work above is not error, it is
        // RESOLUTION: a caster's silhouette is rasterised onto the map's texel
        // grid, so a straight edge is stored as a staircase whose steps are one
        // texel tall and, for an edge at a shallow angle to the grid, many
        // texels long. Filtering spreads each step into a ramp but cannot
        // shorten the runs between them, so the edge keeps a periodic
        // saw-tooth. A hardware comparison sampler would produce exactly the
        // same one; it is not a defect in this filter.
        //
        // Periodicity is what makes it visible. The eye finds a repeating comb
        // instantly and ignores the same amount of error scattered. Rotating
        // the tap pattern by a per-pixel angle turns the comb into grain at no
        // extra fetches, which is the same trade every engine that uses a
        // rotated Poisson disk is making.
        float angle = 6.2831853 * Math.Fract(
            52.9829189 * Math.Fract(0.06711056 * pixel.x + 0.00583715 * pixel.y));
        vec2 spin = vec2(Math.Cos(angle), Math.Sin(angle)) * (uShadowFilterRadius * uShadowTexel);

        float sum = CompareBilinear(s.xy + vec2(spin.x, spin.y), rect, reference)
                  + CompareBilinear(s.xy + vec2(-spin.y, spin.x), rect, reference)
                  + CompareBilinear(s.xy + vec2(-spin.x, -spin.y), rect, reference)
                  + CompareBilinear(s.xy + vec2(spin.y, -spin.x), rect, reference);

        return Math.Mix(1.0, sum * 0.25, uShadowStrength);
    }

    // Cook-Torrance: D * G * F over 4 (N.L)(N.V), plus a Lambert diffuse for
    // whatever energy the Fresnel term did not reflect.
    vec3 Shade(vec3 n, vec3 v, vec3 l, vec3 diffuseColor, vec3 f0, float roughness) {
        float ndotl = Math.Max(Math.Dot(n, l), 0.0);
        if (ndotl <= 0.0) {
            return vec3(0.0, 0.0, 0.0);
        }

        float ndotv = Math.Max(Math.Dot(n, v), 0.0001);
        vec3 h = Math.Normalize(v + l);
        float ndoth = Math.Max(Math.Dot(n, h), 0.0);
        float vdoth = Math.Max(Math.Dot(v, h), 0.0);

        // Disney's reparameterisation: perceptual roughness squared, so an
        // artist's 0..1 slider behaves linearly to the eye rather than
        // collapsing everything interesting into the bottom tenth.
        float a = roughness * roughness;
        float a2 = a * a;

        // GGX / Trowbridge-Reitz normal distribution.
        float denom = ndoth * ndoth * (a2 - 1.0) + 1.0;
        float d = a2 / Math.Max(3.14159265 * denom * denom, 0.0000001);

        // Smith visibility, HEIGHT-CORRELATED (Heitz 2014), already divided by
        // the BRDF's 4 (N.L)(N.V) denominator. Folding the two together is both
        // cheaper and better conditioned than computing G and dividing after.
        //
        // The two sqrts are what separates this from Schlick's k approximation,
        // which is the version most tutorials carry. They buy the correlation
        // between the shadowing and masking terms, and the difference shows
        // exactly where a smooth surface turns away from the viewer: the
        // uncorrelated form overestimates there and rings the silhouette with a
        // bright rim that is easy to mistake for a working Fresnel.
        float lambdaV = ndotl * Math.Sqrt(ndotv * ndotv * (1.0 - a2) + a2);
        float lambdaL = ndotv * Math.Sqrt(ndotl * ndotl * (1.0 - a2) + a2);
        float vis = 0.5 / Math.Max(lambdaV + lambdaL, 0.0000001);

        // Schlick's Fresnel.
        float fresnelWeight = Math.Pow(1.0 - vdoth, 5.0);
        vec3 f = f0 + (vec3(1.0, 1.0, 1.0) - f0) * fresnelWeight;

        vec3 specular = f * (d * vis);

        // Energy conservation: what the surface reflected specularly cannot also
        // be diffused. Without this a rough metal is brighter than the light
        // that hit it.
        vec3 kd = vec3(1.0, 1.0, 1.0) - f;
        vec3 diffuse = kd * diffuseColor / 3.14159265;

        return (diffuse + specular) * ndotl;
    }
}
