// WorldLineGBuffer.spectrashade — the depth-tested world line, written into a
// deferred G-buffer.
//
// WHY THIS EXISTS AT ALL. The engine's debug overlay draws with depth testing
// OFF, on top of the tone-map resolve, and that is correct for what it carries:
// gizmo handles and the selection outline are editor chrome that must never be
// hidden by the geometry they describe. A ground grid is the opposite kind of
// thing. It is part of the WORLD, it is at y = 0, and a grid drawn through the
// walls of a room is not a grid, it is a fault. So the grid needs a second lane
// that depth-tests, and this is the deferred half of it.
//
// WHY IT WRITES ALL FIVE ATTACHMENTS. The only pass in a deferred frame that
// owns the scene's depth is the G-buffer pass: the light pass afterwards is a
// full-screen triangle into a target whose own depth buffer was never written,
// so a depth-tested draw there would test against a cleared buffer and show
// through everything - the exact failure this lane exists to avoid. Drawing
// inside the G-buffer pass means writing what a G-buffer pass writes, and
// leaving an attachment unwritten is not an option: they are deliberately never
// cleared (the depth buffer is the coverage mask), so an unwritten channel holds
// the PREVIOUS frame's value and the light pass would shade the line with a
// stale normal and a stale roughness.
//
// The trick is that emissive carries the line and albedo is black, so the light
// pass adds exactly the authored colour and no light of any kind lands on it.
// A grid line is a display colour, like the overlay's, and must not change
// brightness because the camera turned towards a lamp.
//
// The forward and wireframe pipelines need none of this: their scene pass owns
// its own depth, so they flush the same vertices with the ordinary DebugLine
// shader and depth testing switched on.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 color;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 color;
}

struct FragmentInput {
    vec3 color;
}

// The layout documented on GBuffer, and the second file that writes it. The
// other is GBufferFill; if the layout ever moves, both change together.
struct GBufferOutput {
    [Target(0)] vec4 albedoAo;
    [Target(1)] vec4 normalRoughness;
    [Target(2)] vec4 materialData;
    [Target(3)] vec4 emissive;
    [Target(4)] vec4 custom;
}

shader WorldLineGBuffer {
    [Binding(0)] cbuffer Camera {
        mat4 uView;
        mat4 uProjection;
        vec3 uCameraPosition;
        float uDepthNudge;
    }

    // Identical to WorldLine's, deliberately: the two lanes must place a line at
    // the same depth or a grid would sit at one height under the forward
    // pipeline and another under the deferred one, which reads as a rendering
    // bug that appears only when somebody presses the pipeline key.
    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        vec3 nudged = input.position + (uCameraPosition - input.position) * uDepthNudge;
        output.position = uProjection * uView * vec4(nudged, 1.0);
        output.color = input.color;
        return output;
    }

    [Fragment]
    GBufferOutput FragmentMain(FragmentInput input) {
        var output = new GBufferOutput();

        // Black albedo with full ambient occlusion: no diffuse response, and
        // nothing for the ambient term to lift either.
        output.albedoAo = vec4(0.0, 0.0, 0.0, 1.0);

        // Straight up, fully rough, fully dielectric. None of it is read for a
        // black albedo, but all of it must be WRITTEN, because these
        // attachments are never cleared and the previous frame's values are
        // whatever happened to be under this pixel.
        output.normalRoughness = vec4(0.0, 1.0, 0.0, 1.0);
        output.materialData = vec4(0.0, 0.0, 0.0, 0.0);

        // The line itself. Emissive is added at every non-sky pixel, so the
        // colour arrives unchanged.
        output.emissive = vec4(input.color, 0.0);

        output.custom = vec4(0.0, 0.0, 0.0, 0.0);
        return output;
    }
}
