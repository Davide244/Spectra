// ShadowDepth.spectrashade - the shadow map's depth pass.
//
// Writes nothing but depth. There is no render target bound while this runs, so
// whatever the fragment stage returns is discarded by the hardware; the pass
// exists entirely for the side effect of filling the depth buffer with the
// distance from the light to the nearest surface.
//
// The fragment stage is here because SpectraShade has no vertex-only pipeline,
// not because anything reads it. Keep it trivial: every instruction in it is
// paid for at shadow-map resolution across every caster, for a value nobody
// looks at.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader ShadowDepth {
    [Binding(0)] cbuffer Transforms {
        // [PerInstance] does not change THIS stage at all. It tells the
        // compiler to emit a second vertex stage alongside it, identical except
        // that the matrix arrives as a per-instance vertex input, so a batch of
        // casters is one draw instead of N. A single draw still takes the
        // uniform and pays nothing for the variant existing.
        //
        // The alternative was a hand-written twin of this file, which is fine
        // for a depth pass and is not fine for GBufferFill; see InstancedVariant.
        [PerInstance] mat4 uModel;
        mat4 uLightViewProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uLightViewProjection * uModel * vec4(input.position, 1.0);
        output.uv = input.uv;
        return output;
    }

    [Fragment]
    void FragmentMain(FragmentInput input) {
    }
}
