// GBufferFill.spectrashade — the deferred geometry pass.
//
// Writes surface properties, never light. Nothing here knows how many lights
// exist or where they are; that is the light pass's problem, and separating the
// two is the whole point of deferred: geometry is rasterised once no matter how
// many lights reach it.
//
// The five outputs are the layout documented on GBuffer. Position is absent on
// purpose, because it reconstructs exactly from the depth buffer and storing it
// would cost a whole attachment for information already written.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 worldNormal;
    vec2 uv;
}

struct FragmentInput {
    vec3 worldNormal;
    vec2 uv;
}

// One field per attachment. The analyzer enforces that no two [Target] indices
// collide, which is the one thing it does check, and the one that would
// otherwise silently write two channels into one surface.
struct GBufferOutput {
    [Target(0)] vec4 albedoAo;
    [Target(1)] vec4 normalRoughness;
    [Target(2)] vec4 materialData;
    [Target(3)] vec4 emissive;
    [Target(4)] vec4 custom;
}

shader GBufferFill {
    [Binding(0)] cbuffer Transforms {
        mat4 uModel;
        mat4 uView;
        mat4 uProjection;
    }

    [Binding(1)] cbuffer Surface {
        vec3 uBaseColor;
        float uRoughness;
        float uMetallic;
        float uAmbientOcclusion;
        vec3 uEmissive;
        float uShadingModel;
    }

    [Binding(0)] sampler2D uDiffuse;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * uModel * vec4(input.position, 1.0);
        output.worldNormal = mat3(uModel) * input.normal;
        output.uv = input.uv;
        return output;
    }

    [Fragment]
    GBufferOutput FragmentMain(FragmentInput input) {
        var output = new GBufferOutput();

        vec3 albedo = uBaseColor * uDiffuse.Sample(input.uv).rgb;

        // Renormalised here rather than trusted: the interpolator gives the
        // linear blend of three unit vectors, which is not a unit vector, and a
        // short normal reads as a darker surface in the light pass.
        vec3 n = Math.Normalize(input.worldNormal);

        output.albedoAo = vec4(albedo, uAmbientOcclusion);

        // The normal is stored raw rather than remapped into 0..1, because the
        // attachment is a float format with room for the sign. An 8-bit
        // attachment would need the remap and would band visibly on smooth
        // surfaces.
        output.normalRoughness = vec4(n, uRoughness);

        output.materialData = vec4(uMetallic, uShadingModel, 0.0, 0.0);
        output.emissive = vec4(uEmissive, 0.0);

        // Unused by the standard shading model. Subsurface scattering and
        // clearcoat will read it according to uShadingModel.
        output.custom = vec4(0.0, 0.0, 0.0, 0.0);

        return output;
    }
}
