// ShadowDepthInstanced.spectrashade - the shadow map's depth pass, batched.
//
// The instanced twin of ShadowDepth. It exists because a caster is redrawn once
// per cascade, so a level dressed with N copies of one prop costs 4N draws in
// this pass alone, and that was measured as the single largest share of the
// frame in repeated content (docs/performance.md 6.1).
//
// THE ONLY DIFFERENCE IS WHERE THE MODEL MATRIX COMES FROM. There it is a
// cbuffer uniform rewritten per draw; here it is a per-instance vertex input,
// so one draw carries N of them. Everything else is deliberately identical, and
// the pair is small enough that keeping them in step is a glance rather than a
// discipline - which is exactly why THIS pass was instanced first and the
// G-buffer pass was not. Duplicating a five-attachment write would have been a
// drift hazard; duplicating an empty fragment stage is not.
//
// The rate is not written here and cannot be: neither GLSL nor HLSL expresses
// it in shader text. The compiled output reports it and the renderer binds
// accordingly. See LANGUAGE.md, "Per-instance inputs".

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;

    // Locations 3 through 6: a mat4 occupies four of them.
    [Location(3)][PerInstance] mat4 model;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader ShadowDepthInstanced {
    [Binding(0)] cbuffer Transforms {
        mat4 uLightViewProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uLightViewProjection * input.model * vec4(input.position, 1.0);
        output.uv = input.uv;
        return output;
    }

    // Empty, exactly as in ShadowDepth: no render target is bound while this
    // runs, so a fragment stage that returned a colour would make D3D11 log a
    // warning per draw into the info queue the engine reads for real errors.
    [Fragment]
    void FragmentMain(FragmentInput input) {
    }
}
