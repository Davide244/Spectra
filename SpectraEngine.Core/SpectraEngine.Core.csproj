<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The engine ships NativeAOT (see SpectraEngine.Executable). Without this,
      the trim/AOT/single-file analysers only run when an executable publishes,
      so a library-side violation is found minutes later at ILC time and
      attributed to the exe. IsAotCompatible turns them on for this project's
      ordinary build, which is where the offending line actually lives.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Graphics\BaseShaders\**\*.spectrashade" />
    <EmbeddedResource Include="Graphics\BaseShaders\**\*.spectrashade" />
  </ItemGroup>

  <!--
    Repo content (textures, and later materials/models) ships as real files, not
    embedded resources: the asset pipeline loads them from disk and hot-reloads
    them on save. Copying them under <output>\Assets mirrors the repo's Assets\
    layout so AssetManager's content root resolves identically in a deployed
    build, where the source tree is gone. TargetPath (not just Link) is what
    makes the copy flow to projects that reference this one.
  -->
  <ItemGroup>
    <Content Include="..\Assets\Textures\**\*.*"
             Link="Assets\Textures\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Textures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Materials\**\*.spectramat"
             Link="Assets\Materials\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Materials\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      Models ship whole: a .obj needs its .mtl beside it and a .gltf may need a
      .bin, so this copies the folder rather than a single extension.
    -->
    <Content Include="..\Assets\Models\**\*.*"
             Link="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="Silk.NET" />
    <PackageReference Include="Silk.NET.Assimp" />
    <PackageReference Include="Silk.NET.Direct3D11" />
    <PackageReference Include="Silk.NET.Direct3D12" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" />
    <PackageReference Include="Silk.NET.DXGI" />
    <PackageReference Include="Silk.NET.GLFW" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Input.Glfw" />
    <PackageReference Include="Silk.NET.Maths" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenCL" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Windowing.Common" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
    <PackageReference Include="Silk.NET.XInput" />
  </ItemGroup>

</Project>
