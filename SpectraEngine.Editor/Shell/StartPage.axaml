<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.StartPage"
             Background="{StaticResource SpectraBgApp}">

  <!--
    The launch experience: what shows instead of a viewport until a project is
    open. This page exists BEFORE any engine session, so it is ordinary
    Avalonia with no airspace constraint - the one place in the shell that can
    lay out freely.

    It lays out like the rest of the tool rather than like a landing page:
    full-bleed columns instead of a centred island, a dense keyboard-navigable
    list instead of a grid of tiles, and one slim header instead of a hero.
    Every editor a Spectra user already knows (VS, Rider, Studio) opens onto a
    list of things to reopen with the verbs beside it, because the common case
    is "carry on with what I had", not "admire the logo".
  -->

  <UserControl.Resources>
    <!-- Shared by every recent row; DataContext arrives from the row that
         opened it. Remove is list hygiene, not deletion: it forgets the entry
         and touches nothing on disk, and the wording says so. -->
    <ContextMenu x:Key="RecentMenu" x:DataType="shell:RecentProjectRow">
      <MenuItem Header="Open" Click="OnRecentMenuOpen" />
      <MenuItem Header="Show in Explorer" Click="OnRecentMenuReveal" />
      <Separator />
      <MenuItem Header="Remove from list" InputGesture="Delete" Click="OnRecentMenuForget" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Dense list rows, the tool idiom: a fill on hover and selection, no
         border and no card. A bordered rounded tile per entry is what a
         marketing page does with a list of six things; it costs three times
         the vertical space and still says less. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <!-- The action rail. Left-aligned text with a leading glyph, full width:
         a menu of verbs, not a row of call-to-action buttons. -->
    <Style Selector="Button.action">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadius2}" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadius2}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
    </Style>
    <Style Selector="Button.action TextBlock">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.action Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- Column headings: the quietest text on the page, because they are read
         once and then never again. -->
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- No header of its own: the window's own bar is directly above this page
       and already carries the File menu, so identity goes there rather than
       in a second bar under the first. -->
  <DockPanel>

    <!-- ─── Action rail ────────────────────────────────
         Fixed width on the left, where a tool's verbs live. -->
    <Border DockPanel.Dock="Left" Width="236"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="8,10" Spacing="1">
          <Button Classes="action" Click="OnNewProjectClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconNewProject}" />
              <TextBlock Text="New project" />
            </StackPanel>
          </Button>
          <Button Classes="action" Click="OnOpenProjectClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconOpenFolder}" />
              <TextBlock Text="Open project" />
            </StackPanel>
          </Button>
          <Button Classes="action" Click="OnOpenMapClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconMap}" />
              <TextBlock Text="Open map bundle" />
            </StackPanel>
          </Button>

          <!-- Directly under the verbs it explains, not pinned to the far
               bottom of a tall rail where it reads as unrelated small print. -->
          <Border Height="1" Background="{StaticResource SpectraBorderSoft}" Margin="8,10,4,9" />

          <TextBlock TextWrapping="Wrap" Margin="8,0,4,0"
                     FontSize="{StaticResource SpectraFontSecondary}"
                     Foreground="{StaticResource SpectraTextMuted}"
                     Text="A project is a folder: its manifest, Assets, Maps and Scripts. Everything authored is text." />
      </StackPanel>
    </Border>

    <!-- ─── Recents ────────────────────────────────────
         The page's real content, and the reason it exists: reopen what you
         were working on, by keyboard if you like. -->
    <DockPanel Margin="14,10,14,12">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Text="Recent projects"
                   FontSize="{StaticResource SpectraFontBase}"
                   Foreground="{StaticResource SpectraTextBody}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="2" x:Name="FilterBox" Classes="filter" Width="180"
                 PlaceholderText="Filter"
                 TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown" />
      </Grid>

      <!-- Column headings sit outside the scroll, so they stay put. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,1.6*,Auto" Margin="8,0,10,4">
        <TextBlock Grid.Column="0" Classes="colhead" Text="Name" />
        <TextBlock Grid.Column="1" Classes="colhead" Text="Location" />
        <TextBlock Grid.Column="2" Classes="colhead" Text="Opened" />
      </Grid>

      <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource SpectraBorderSoft}" Margin="0,0,0,2" />

      <TextBlock x:Name="EmptyLabel" DockPanel.Dock="Top" Margin="8,14,0,0"
                 Text="Nothing yet. A project you create or open appears here."
                 FontSize="{StaticResource SpectraFontSecondary}"
                 Foreground="{StaticResource SpectraTextMuted}"
                 TextWrapping="Wrap" />

      <ListBox x:Name="RecentList"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               DoubleTapped="OnRecentActivated"
               KeyDown="OnRecentKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:RecentProjectRow">
            <Border Height="26" Background="Transparent"
                    ContextMenu="{StaticResource RecentMenu}"
                    ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="*,1.6*,Auto" Margin="8,0,10,0">
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           FontSize="{StaticResource SpectraFontBase}"
                           Foreground="{StaticResource SpectraTextEmphasis}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <!-- The path is a VALUE, so it wears mono: it is the thing
                     that tells two same-named projects apart. -->
                <TextBlock Grid.Column="1" Text="{Binding Path}"
                           FontFamily="{StaticResource SpectraFontMono}"
                           FontSize="{StaticResource SpectraFontSmall}"
                           Foreground="{StaticResource SpectraTextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="10,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding OpenedLabel}"
                           FontFamily="{StaticResource SpectraFontMono}"
                           FontSize="{StaticResource SpectraFontSmall}"
                           Foreground="{StaticResource SpectraTextMuted}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
