<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpectraEngine.Editor"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.ScenePanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <!--
    The scene tree, self-contained: header, filter, and the flat virtualized
    list, with every style and handler the rows need INSIDE the control so a
    docking layout can host it anywhere without the window donating styles.
  -->

  <UserControl.Resources>
    <shell:SceneNodeKindIconConverter x:Key="KindIcon" />
    <shell:SceneNodeKindBrushConverter x:Key="KindTint" />
    <shell:TreeDepthIndentConverter x:Key="DepthIndent" />

    <!-- One menu, shared by every row: a menu can only be open over one row at
         a time, and its DataContext arrives from whichever row opened it. The
         verbs act on the SELECTION, not the row - the right-press handler has
         already made sure the row is part of it, which is the rule every
         editor shares. Gestures are display text; the real bindings live in
         the tree keyboard and the engine keymap. -->
    <ContextMenu x:Key="RowMenu" x:DataType="local:SceneTreeNode">
      <MenuItem Header="Rename" InputGesture="F2" Click="OnMenuRename" />
      <MenuItem Header="Frame in viewport" InputGesture="F" Click="OnMenuFrame" />
      <Separator />
      <MenuItem Header="Duplicate" InputGesture="Ctrl+D" Click="OnMenuDuplicate" />
      <MenuItem Header="Delete" InputGesture="Delete" Click="OnMenuDelete" />
      <Separator />
      <MenuItem Header="Group" InputGesture="Ctrl+G" Click="OnMenuGroup" />
      <MenuItem Header="Ungroup" InputGesture="Ctrl+Shift+G" Click="OnMenuUngroup" />
      <MenuItem Header="Convert block / part" InputGesture="Ctrl+T" Click="OnMenuConvertKind" />
      <Separator IsVisible="{Binding HasChildren}" />
      <MenuItem Header="Expand all" Click="OnMenuExpandAll" IsVisible="{Binding HasChildren}" />
      <MenuItem Header="Collapse all" Click="OnMenuCollapseAll" IsVisible="{Binding HasChildren}" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Tree rows. Selection and hover are drawn here, from model state and
         the pointer, because Fluent's own row highlight is a different shape
         and would sit underneath this one. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <!-- Every state, named explicitly. Fluent hangs the row fill on the
         template's presenter and picks it per state, so a single transparent
         setter is beaten the moment the row is selected or hovered: the system
         accent comes through as a bright bar the theme never chose. -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The expander. A button rather than a glyph, because it is one, and
         hidden rather than disabled on a node with nothing under it. -->
    <Style Selector="Button.chevron">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="{StaticResource SpectraTreeRowHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.chevron Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Button.chevron:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <!-- TransformOperationsTransition, not TransformTransition: "rotate(90deg)"
         parses to a TransformOperations, and the wrong transition type animates
         nothing while producing no error. This is the single most-noticed
         micro-animation in any tree, and it costs three lines. -->
    <Style Selector="Button.chevron Path">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="{StaticResource SpectraMotionBase}"
                                         Easing="{StaticResource SpectraEaseInOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chevron.open Path">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Height" Value="{StaticResource SpectraTreeRowHeight}" />
      <!-- The FILL ramps; the BORDER does not, and that split is the whole
           reason this is one transition instead of two. The border is the drop
           indicator, which changes at pointer-move rate while a drag crosses
           rows - a 90ms ramp on it would smear the insertion line behind the
           cursor and make the drop position unreadable, which is the one thing
           it exists to say. -->
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Drop indicators. INTO outlines the whole row (it becomes the parent);
         BEFORE/AFTER draw the insertion edge. An edge line, not highlighting,
         because sibling order is placement order here and the drop position
         must read exactly.

         Drawn by an OVERLAY border inside the row, never by the row's own
         border: a Border reserves border space inside its bounds, so the old
         per-class BorderThickness compressed the 24px row's content and the
         label jittered 1-2px under every drag that crossed it. The overlay
         paints over the content and participates in no layout. Still no
         transition on it, for the documented reason: it moves at
         pointer-move rate and a ramp would smear the insertion line. -->
    <Style Selector="Border.dropink">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.row.dropinto Border.dropink">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row.dropbefore Border.dropink">
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.row.dropafter Border.dropink">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <!-- The 2px accent bar is what makes a selected row unmistakable at a
         glance down a long list; the fill alone is too quiet at 22% and too
         loud above it.

         It GROWS from the row's centre rather than appearing. Scale and opacity
         only - never Width, which is layout and would re-measure every row in
         a virtualised list thirty times a second. A transform is composited. -->
    <Style Selector="Border.selbar">
      <Setter Property="Background" Value="{StaticResource SpectraAccent}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scaleY(0.3)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="{StaticResource SpectraMotionBase}"
                            Easing="{StaticResource SpectraEaseOut}" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="{StaticResource SpectraMotionBase}"
                                         Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.row.selected Border.selbar">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scaleY(1)" />
    </Style>

    <Style Selector="TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.row.selected TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <!-- Filtered out, not hidden: removing rows collapses the hierarchy around
         every match and destroys the only thing a user has after two hundred
         nodes, which is knowing where things live. -->
    <Style Selector="Border.row.dim TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Border.row.dim Path">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="Border.row.context TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>

    <!-- The in-place rename editor: the same footprint as the name it
         replaces, so nothing in the row moves when editing starts. -->
    <!-- A filter matching nothing marks itself and its count. Accent, not
         warning yellow: an empty result is not a fault, it is a state, and this
         is the same colour the shell uses for "here is where you are".

         The counter's resting colour is a CLASS, declared before .nomatch so
         the accent wins its tie: set inline it was a LocalValue, which beats
         any class rule, and the count never turned. -->
    <Style Selector="TextBlock.treecount">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="TextBox.field.nomatch /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="TextBlock.value.nomatch">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>

    <Style Selector="TextBox.renamebox">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="Margin" Value="2,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- No panel header: the dock's own tool chrome already names this
         "Scene", and a second decorative title row was vertical cost for no
         information. The count rides the filter row instead, where it is
         also the filter's own feedback. -->
    <Grid DockPanel.Dock="Top" Margin="8,6,8,6" ColumnDefinitions="*,Auto,Auto">
      <TextBox Grid.Column="0" x:Name="FilterBox" Classes="field"
               Classes.nomatch="{Binding HasNoMatches}"
               Text="{Binding FilterText, Mode=TwoWay}"
               PlaceholderText="Filter by name, or t:light"
               KeyDown="OnFilterKeyDown" />
      <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
              Click="OnClearFilterClicked" IsVisible="{Binding HasFilter}"
              ToolTip.Tip="Clear the filter  (Esc)">
        <Path Classes="icon" Data="{StaticResource IconClear}" />
      </Button>
      <TextBlock Grid.Column="2" Classes="value treecount" Text="{Binding TreeCountLabel}"
                 Classes.nomatch="{Binding HasNoMatches}"
                 Margin="6,0,2,0" VerticalAlignment="Center"
                 ToolTip.Tip="Nodes shown / nodes in the scene" />
    </Grid>

    <!-- A filter that matches nothing is otherwise indistinguishable from a
         panel that broke: the rows stay (dimming rather than hiding is what
         preserves the user's spatial memory of their own scene) so a zero-match
         filter dims all 253 of them and changes a five-character counter. This
         says so in words, and offers the way out. -->
    <Border DockPanel.Dock="Top" Margin="8,0,8,6" Padding="8,6"
            Background="{StaticResource SpectraBgInput}"
            BorderBrush="{StaticResource SpectraBorderSoft}"
            BorderThickness="1"
            CornerRadius="{StaticResource SpectraRadiusControl}"
            IsVisible="{Binding HasNoMatches}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="prose" TextWrapping="Wrap"
                   Text="{Binding NoMatchLabel}" />
        <Button Grid.Column="1" Classes="ghost" Click="OnClearFilterClicked"
                ToolTip.Tip="Clear the filter  (Esc)">
          <Path Classes="icon" Data="{StaticResource IconClear}" />
        </Button>
      </Grid>
    </Border>

    <!--
      A flat list, not a tree control. A TreeView realises a container per
      node whether or not it can be seen, which at this engine's own ceiling
      of 25,000 nodes means building twenty-five thousand rows to show
      thirty-five. The model flattens to the visible rows and carries each
      one's depth, so the panel virtualizes like any list and the indent is
      a margin.
    -->
    <ListBox x:Name="SceneTree"
             ItemsSource="{Binding Tree.Rows}"
             SelectionMode="Multiple"
             AutoScrollToSelectedItem="False"
             SelectionChanged="OnTreeSelectionChanged"
             Background="Transparent"
             BorderThickness="0"
             Padding="0,2,0,4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <!-- The default panel already, named so the realisation buffer can
               be set: it defaults to zero, which realises exactly the
               visible rows and pops one in at each edge as you scroll. Half
               a viewport either side costs about thirty more rows. -->
          <VirtualizingStackPanel CacheLength="0.5" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:SceneTreeNode">
          <!-- The indent lives on the CONTENT, not the row: hover, selection
               and the drop indicators span the panel (the way every outliner
               draws them), and the hover no longer disagrees with the click -
               the gutter left of a deep row always selected, and used to show
               no hover at all. The selection bar stays pinned at the edge. -->
          <Border Classes="row"
                  Classes.selected="{Binding IsSelected}"
                  Classes.dim="{Binding IsDimmed}"
                  Classes.context="{Binding IsContext}"
                  Classes.dropbefore="{Binding IsDropBefore}"
                  Classes.dropinto="{Binding IsDropInto}"
                  Classes.dropafter="{Binding IsDropAfter}"
                  ContextMenu="{StaticResource RowMenu}"
                  DoubleTapped="OnRowDoubleTapped">
            <Panel>
              <Grid ColumnDefinitions="2,*">
                <Border Grid.Column="0" Classes="selbar" Margin="0,3" CornerRadius="1" />
                <Grid Grid.Column="1" ColumnDefinitions="14,Auto,*"
                      Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                  <Button Grid.Column="0" Classes="chevron"
                          Classes.open="{Binding IsExpanded}"
                          IsVisible="{Binding HasChildren}"
                          Click="OnChevronClicked" PointerPressed="OnChevronPressed">
                    <Path Data="{StaticResource IconChevronRight}" />
                  </Button>
                  <Path Grid.Column="1" Classes="icon"
                        Data="{Binding Kind, Converter={StaticResource KindIcon}}"
                        Stroke="{Binding Kind, Converter={StaticResource KindTint}}"
                        Width="15" Height="15"
                        RenderTransform="scale(1.05)"
                        Margin="2,0,0,0" />
                  <!-- The tooltip is the whole name. Rows trim with an ellipsis and
                       the panel does not scroll sideways, so at 288px a name three
                       levels deep is unreadable and there was no way to see it at
                       all short of dragging the splitter. -->
                  <TextBlock Grid.Column="2" Classes="rowname" Text="{Binding Name}" Margin="6,0,4,0"
                             IsVisible="{Binding !IsRenaming}"
                             ToolTip.Tip="{Binding Name}" />
                  <!-- Text is set imperatively when editing begins, never bound:
                       a binding would let a ~30 Hz snapshot republish rewrite the
                       box mid-keystroke, which reads as a broken keyboard. -->
                  <TextBox Grid.Column="2" Classes="renamebox"
                           IsVisible="{Binding IsRenaming}"
                           KeyDown="OnRenameKeyDown"
                           LostFocus="OnRenameBlurred" />
                </Grid>
              </Grid>
              <Border Classes="dropink" />
            </Panel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
