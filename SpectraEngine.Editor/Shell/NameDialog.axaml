<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpectraEngine.Editor.Shell.NameDialog"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SpectraBgApp}"
        Title="Name">

  <!--
    A real modal WINDOW, not an in-window overlay, and that distinction is the
    airspace rule rather than a style choice: the viewport is a native child
    window that composites above anything Avalonia draws, so a panel floated
    over the shell would be invisible wherever it crossed the viewport. A
    separate top-level window has its own surface and is unaffected.
  -->
  <Border Padding="16" BorderThickness="1" BorderBrush="{StaticResource SpectraBorderSoft}">
    <StackPanel Spacing="12">
      <TextBlock x:Name="PromptText"
                 Foreground="{StaticResource SpectraTextBody}"
                 FontSize="{StaticResource SpectraFontBase}"
                 TextWrapping="Wrap" />

      <!-- The .field recipe, not inline brushes: control-level values only
           reach the template part at TemplateBinding priority, so Fluent's
           hover and focus triggers replaced them with stock fills. The one
           text box in the shell with zero authored state behaviour was the
           one in a modal asking for a name. -->
      <TextBox x:Name="Input" Classes="field"
               Height="30" MinHeight="30"
               Padding="8,4"
               FontSize="{StaticResource SpectraFontBase}"
               KeyDown="OnInputKeyDown" />

      <TextBlock x:Name="ErrorText"
                 Foreground="{StaticResource SpectraWarning}"
                 FontSize="{StaticResource SpectraFontSmall}"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <!-- The dialog recipe, not toolbar chips with hand-painted fills: a
           chip dressed as a confirm button is two controls dressed as each
           other, the exact failure the affordance rule exists to prevent. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel" MinWidth="104" />
        <Button Classes="primary" Content="OK" Click="OnAccept" MinWidth="104" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
