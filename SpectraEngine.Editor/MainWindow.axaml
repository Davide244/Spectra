<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:SpectraEngine.Editor.Viewport"
        xmlns:local="clr-namespace:SpectraEngine.Editor"
        xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dm="clr-namespace:Dock.Model.Avalonia.Controls;assembly=Dock.Model.Avalonia"
        x:Class="SpectraEngine.Editor.MainWindow"
        x:DataType="shell:ShellModel"
        Title="Spectra Editor"
        Width="1480" Height="920"
        MinWidth="1180" MinHeight="640"
        Background="{StaticResource SpectraBgApp}">

  <!--
    Four rows, none of which overlaps the viewport.

    THE AIRSPACE RULE, RESTATED, BECAUSE IT IS NARROWER THAN IT USED TO BE.
    The viewport is a native child window and composites above everything
    Avalonia draws INTO THIS WINDOW: an overlay, an adorner, a drop shadow or a
    dock float drawn in the managed layer is invisible wherever it crosses the
    viewport's cell. A POPUP is a different thing. On Windows an Avalonia popup
    is a real OS window, so context menus, menu flyouts, combo dropdowns,
    tooltips and modal dialogs all composite ABOVE the native child - measured,
    with a tree row's context menu opening 300px out over live 3D.

    That is why this window has five menus. The previous shell had one, and
    retired Edit and View on the reasoning that their flyouts would open past
    the 280px tree column and vanish; the reasoning was sound and the premise
    was wrong. Menus are the cheapest way to make every verb reachable a second
    way with its shortcut printed beside it, which is the single largest
    discoverability change available here.

    ONE command row, not a tab strip. The strip was three tabs whose Home and
    Model pages carried the same six verbs and whose Frame button was written
    out three times, so switching mostly did nothing and taught the user the
    tabs were decorative - while the one thing a first session actually needs,
    inserting an object, sat on the tab nobody opened. The structural verbs
    (duplicate, group, ungroup, delete) left the bar entirely: they were four
    anonymous glyphs, and they are on the keyboard, in the Object menu and in
    every row's context menu already.
  -->

  <Window.Styles>
    <!-- The document identity in the menu row. -->
    <Style Selector="TextBlock.docname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.docproject">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The status bar's message zone. Prose, so it is set in the UI face:
         these are whole sentences and they used to be rendered in 11px
         Cascadia Mono. -->
    <Style Selector="TextBlock.statusmsg">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statusmsg.errormsg">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- The resting tint is a CLASS, not a local attribute: a local Foreground
         outranks every style, so the over-budget colour below could never
         apply through it. Declared before .overbudget so the threshold state
         wins on order. -->
    <Style Selector="TextBlock.frametime">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="TextBlock.overbudget">
      <Setter Property="Foreground" Value="{StaticResource SpectraWarning}" />
    </Style>

    <!-- The play button. Filled glyphs, and the two faces are the only place
         in the shell that spends a semantic colour on a control: success green
         to start (the brand red means SELECTED here, and a red play button
         reads as record), accent to stop, because stopping is the loud state.
         The disabled override comes LAST so it wins on order over both. -->
    <Style Selector="Button.playbtn">
      <Setter Property="Height" Value="{StaticResource SpectraControlHeight}" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.playbtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>
    <Style Selector="Button.playbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    </Style>
    <Style Selector="Button.playbtn Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraSuccess}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraSuccess}" />
    </Style>
    <Style Selector="Button.playbtn Path.stopglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraAccent}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="Button.playbtn:disabled Path">
      <Setter Property="Fill" Value="{StaticResource SpectraTextDisabled}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Button.playbtn:disabled">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>

    <!-- A field that lives INSIDE a raised cluster: sunken fill so it still
         reads as somewhere you type, no resting border because the capsule
         around it already draws one, and an accent border while focused. -->
    <Style Selector="TextBox.field.inline">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBgInput}" />
    </Style>
    <Style Selector="TextBox.field.inline /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBgInput}" />
    </Style>
    <Style Selector="TextBox.field.inline:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    </Style>
    <Style Selector="TextBox.field.inline:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ============ Menu row ==========================
         Five menus, then the document's identity and Play at the far right.
         Play is here rather than in the command row so it never moves and is
         never one of a crowd: stopping a run must be the easiest thing on
         screen to hit. -->
    <Border Grid.Row="0"
            Height="{StaticResource SpectraMenuBarHeight}"
            Background="{StaticResource SpectraBgApp}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <Menu Grid.Column="0" VerticalAlignment="Center" Margin="4,0,0,0">

          <MenuItem Header="_File">
            <MenuItem Header="_New project..." Click="OnNewProjectClicked" />
            <MenuItem Header="_Open project..." Click="OnOpenProjectClicked" />
            <!-- Populated in code from the same recents the start page shows:
                 a menu built from settings at open time cannot drift from the
                 list. Items land BEFORE the trailing clear entry. -->
            <MenuItem Header="Recent p_rojects" x:Name="RecentProjectsMenu">
              <MenuItem Header="(nothing yet)" IsEnabled="False" x:Name="RecentProjectsEmptyItem" />
              <Separator x:Name="RecentProjectsSeparator" />
              <MenuItem Header="Clear list" Click="OnClearRecentsClicked" x:Name="RecentProjectsClearItem" />
            </MenuItem>
            <MenuItem Header="_Close project" Click="OnCloseProjectClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="New _level" InputGesture="Ctrl+N" Click="OnNewMapClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Open _level..." InputGesture="Ctrl+O" Click="OnOpenMapClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="E_xit" Click="OnExitClicked" />
          </MenuItem>

          <MenuItem Header="_Edit" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUndo}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRedo}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Move tool" InputGesture="W" Click="OnMoveClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconMove}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Rotate tool" InputGesture="E" Click="OnRotateClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRotate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Size tool" InputGesture="R" Click="OnResizeClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconResize}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Snap to grid" InputGesture="G" Click="OnSnapClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGrid}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Finer grid" InputGesture="OemOpenBrackets" Click="OnSnapFinerClicked" />
            <MenuItem Header="Coarser grid" InputGesture="OemCloseBrackets" Click="OnSnapCoarserClicked" />
            <Separator />
            <MenuItem Header="{Binding OrientationMenuLabel}" InputGesture="X" Click="OnOrientationClicked" />
            <MenuItem Header="{Binding GizmoStyleMenuLabel}" InputGesture="Y" Click="OnStyleClicked" />
          </MenuItem>

          <!-- Everything that makes or changes an object. This is where a
               newcomer looks for "how do I add something", so Insert is the
               first item rather than buried under a tab. -->
          <MenuItem Header="_Object" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Insert block" InputGesture="Ctrl+D1" Click="OnInsertWorldBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-world" Data="{StaticResource IconBrushWorld}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert part" InputGesture="Ctrl+D2" Click="OnInsertPartBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-part" Data="{StaticResource IconBrushPart}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert cut" InputGesture="Ctrl+D3" Click="OnInsertSubtractiveBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-cut" Data="{StaticResource IconBrushSubtractive}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert light" InputGesture="Ctrl+D4" Click="OnInsertLightClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-light" Data="{StaticResource IconLight}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert empty group" Click="OnInsertGroupClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroup}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Duplicate" InputGesture="Ctrl+D" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDuplicate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Delete" InputGesture="Delete" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDelete}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Group" InputGesture="Ctrl+G" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Ungroup" InputGesture="Ctrl+Shift+G" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUngroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Convert block / part" InputGesture="Ctrl+T" Click="OnToggleBrushKindClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconConvertKind}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Frame in viewport" InputGesture="F" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconFrame}" /></MenuItem.Icon></MenuItem>
          </MenuItem>

          <MenuItem Header="_View" IsEnabled="{Binding HasSession}">
            <!-- Built in code from the backend's own pipeline list, radio
                 checked, because which pipelines exist depends on the
                 renderer that started. -->
            <MenuItem Header="Renderer" x:Name="RendererMenu" />
            <Separator />
            <MenuItem Header="Wireframe" InputGesture="F1" ToggleType="CheckBox"
                      IsChecked="{Binding DebugWireframe, Mode=OneWay}" Click="OnDebugWireClicked" />
            <MenuItem Header="CSG vertices" InputGesture="F2" ToggleType="CheckBox"
                      IsChecked="{Binding DebugVertices, Mode=OneWay}" Click="OnDebugVerticesClicked" />
            <MenuItem Header="Bounds" InputGesture="F3" ToggleType="CheckBox"
                      IsChecked="{Binding DebugAabbs, Mode=OneWay}" Click="OnDebugAabbsClicked" />
            <MenuItem Header="Face normals" InputGesture="F4" ToggleType="CheckBox"
                      IsChecked="{Binding DebugNormals, Mode=OneWay}" Click="OnDebugNormalsClicked" />
            <MenuItem Header="Node axes" InputGesture="F5" ToggleType="CheckBox"
                      IsChecked="{Binding DebugSceneGraph, Mode=OneWay}" Click="OnDebugSceneGraphClicked" />
            <Separator />
            <MenuItem Header="{Binding NavigationMenuLabel}" InputGesture="F7" Click="OnToggleNavigationClicked" />

          </MenuItem>

          <MenuItem Header="_Help">
            <MenuItem Header="Keyboard reference" Click="OnKeyboardReferenceClicked" />
            <Separator />
            <MenuItem Header="{Binding AboutLabel}" IsEnabled="False" />
          </MenuItem>
        </Menu>

        <!-- With nothing open the bar carries the product's identity where the
             document cluster otherwise sits, so the start page needs no header
             of its own and the bar never changes height. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    IsVisible="{Binding !HasSession}">
          <Border Width="10" Height="10"
                  CornerRadius="{StaticResource SpectraRadiusControl}"
                  Background="{StaticResource SpectraAccent}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Spectra Editor" Classes="docname" />
          <TextBlock x:Name="VersionLabel" Classes="value"
                     Foreground="{StaticResource SpectraTextMuted}" />
        </StackPanel>

        <!-- WHAT AM I EDITING. The window title used to answer this with
             "Demo - Demo - Spectra Editor"; here the level is the loud half,
             the project is context, and the dot is the unsaved mark. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding HasSession}">
          <TextBlock Classes="docproject" Text="{Binding ProjectName}"
                     IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docproject" Text="/" IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docname" Text="{Binding DocumentName}" />
          <Border Width="6" Height="6" CornerRadius="3"
                  Background="{StaticResource SpectraWarning}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsDocumentDirty}"
                  ToolTip.Tip="Unsaved changes" />
          <Border Classes="groupsep" />
          <Button Classes="playbtn" Click="OnPlayClicked"
                  IsEnabled="{Binding CanPlay}" ToolTip.Tip="{Binding PlayTip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel Width="16" Height="16">
                <Path Classes="icon playglyph" Data="{StaticResource IconPlay}"
                      StrokeThickness="0" IsVisible="{Binding !IsPlaying}" />
                <Path Classes="icon stopglyph" Data="{StaticResource IconStop}"
                      StrokeThickness="0" IsVisible="{Binding IsPlaying}" />
              </Panel>
              <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Command bar ========================
         One row of raised clusters. A cluster is one bordered capsule holding
         the controls of one decision, which is what makes grouping visible
         instead of implied by a hairline nobody notices. -->
    <Border Grid.Row="1"
            Height="{StaticResource SpectraToolbarHeight}"
            Background="{StaticResource SpectraBgApp}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1"
            IsVisible="{Binding HasSession}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

          <!-- Tools. Labelled, not icon-only: this is the row a first session
               reads, and an icon-only strip is fast for the hand and mute for
               the eye. Roblox Studio labels every button in its ribbon and is
               right to. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.active="{Binding IsMoveActive}"
                      Click="OnMoveClicked" ToolTip.Tip="Move the selection.  2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconMove}" />
                  <TextBlock Text="Move" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Classes.active="{Binding IsRotateActive}"
                      Click="OnRotateClicked" ToolTip.Tip="Rotate the selection.  4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconRotate}" />
                  <TextBlock Text="Rotate" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Classes.active="{Binding IsResizeActive}"
                      Click="OnResizeClicked" ToolTip.Tip="Change the selection's size.  3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconResize}" />
                  <TextBlock Text="Size" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Snap. ONE field, not three: it holds the increment of whichever
               tool is live and says which unit that is, so the number in front
               of you always means the drag you are about to make. Three boxes
               labelled mv / rot / sz asked the user to keep a mapping in their
               head and abbreviated the three words that would have made it
               unnecessary. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.active="{Binding SnapEnabled}" Width="26" Padding="0"
                      Click="OnSnapClicked" ToolTip.Tip="Snap drags to the grid.  G">
                <Path Classes="icon" Data="{StaticResource IconGrid}" />
              </Button>
              <Border Classes="segsep" />
              <TextBox x:Name="SnapBox" Classes="field num inline" Width="54"
                       Margin="4,0,0,0" VerticalAlignment="Center"
                       GotFocus="OnSnapFieldFocused"
                       LostFocus="OnSnapFieldBlurred" KeyDown="OnSnapFieldKeyDown"
                       ToolTip.Tip="Grid size for the live tool. [ and ] step it." />
              <TextBlock Classes="label" Text="{Binding SnapUnitLabel}"
                         Margin="5,0,8,0" MinWidth="20" />
            </StackPanel>
          </Border>

          <!-- Two-way choices. A chip carries its SUBJECT and its VALUE, because
               "world" is not the enabled state of "local" and a box containing
               only the word "Studio" is a word with nothing to attach it to. -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="chip" Click="OnOrientationClicked"
                    ToolTip.Tip="Which axes a drag resolves against.  X">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chipsubject" Text="Axes" />
                <TextBlock Classes="chipvalue" Text="{Binding Orientation}" />
              </StackPanel>
            </Button>
            <Button Classes="chip" Click="OnStyleClicked"
                    ToolTip.Tip="Studio puts a handle on every face and anchors a resize to the opposite one. Classic puts three handles on the pivot and resizes about it.  Y">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chipsubject" Text="Handles" />
                <TextBlock Classes="chipvalue" Text="{Binding GizmoStyle}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Width="26" Padding="0" Click="OnUndoClicked"
                      IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}">
                <Path Classes="icon" Data="{StaticResource IconUndo}" />
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Width="26" Padding="0" Click="OnRedoClicked"
                      IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}">
                <Path Classes="icon" Data="{StaticResource IconRedo}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Insert. On the ONE command row, and first among equals for a new
               user: this is the group that answers "how do I put something in
               the world", and it used to live on a tab that opened to a
               different set of buttons. Each lands on the surface at the centre
               of the view, snapped to the grid, selected, one undo entry. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Click="OnInsertWorldBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Solid geometry. Merges with the rest of the level and can be cut.  Ctrl+1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-world" Data="{StaticResource IconBrushWorld}" />
                  <TextBlock Text="Block" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertPartBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Moves and animates freely, and never merges. Use it for anything that has to move.  Ctrl+2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-part" Data="{StaticResource IconBrushPart}" />
                  <TextBlock Text="Part" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertSubtractiveBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Carves a hole out of the blocks it overlaps. Doorways and windows.  Ctrl+3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-cut" Data="{StaticResource IconBrushSubtractive}" />
                  <TextBlock Text="Cut" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertLightClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="A point light.  Ctrl+4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-light" Data="{StaticResource IconLight}" />
                  <TextBlock Text="Light" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Frame the selection.  F">
            <Path Classes="icon" Data="{StaticResource IconFrame}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Start page | editor ================
         Two states of one row. The start page shows while NO engine session
         exists, which is the only time free layout is possible at all: the
         viewport's native child window is created when a session launches and
         composites above anything Avalonia draws from then on. The code behind
         switches the two explicitly, because the viewport must leave the tree
         BEFORE the editor view hides, never after. -->
    <Panel Grid.Row="2">

      <shell:StartPage x:Name="StartView" />

      <!-- ============ Panels | viewport ================
           DOCKED, all of it. Every panel owns its own grid cell and none of
           them intersect the viewport's, because a NativeControlHost's child
           composites above anything Avalonia draws in this window. -->
      <Grid x:Name="EditorView" IsVisible="False" ColumnDefinitions="288,1,*,1,308">

        <!-- Two DockControls, one per side, with the viewport PINNED between
             them in a plain grid cell. That pinning is not taste: the viewport
             is a NativeControlHost, and any dock arrangement that re-parents it
             destroys the HWND and the whole engine session with it, so it never
             enters a dock. The panels do: they can be re-stacked, tabbed and
             floated (a floated panel is a real OS window, which is exactly why
             it may cross the viewport). -->
        <dock:DockControl x:Name="LeftDock" Grid.Column="0" InitializeLayout="True" InitializeFactory="True">
          <!-- Native floats, never the managed in-window layer: a managed float
               is drawn in THIS window's Avalonia layer, which the viewport's
               native child composites over - the float would be invisible
               exactly where people drop panels. -->
          <dm:RootDock x:Name="LeftRoot" Id="LeftRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #LeftLayout}">
            <dm:ProportionalDock x:Name="LeftLayout" Id="LeftLayout" Orientation="Vertical">
              <!-- The tools' CONTENT is assigned in code, deliberately: XAML
                   element content of a Tool compiles to a deferred template
                   that builds fresh controls per layout change, while a
                   Control assigned to Tool.Content is returned as-is by the
                   dock's builder - one live, event-wired panel instance that
                   survives every re-dock and float. -->
              <!-- 0.11, down from 0.16: a project has one or two levels for
                   most of its life, and the pane was spending a seventh of the
                   tallest column in the window on a single 24px row while the
                   scene tree below it scrolled 253 nodes. CanPin is off on
                   every tool here: Dock's pinned flyout is drawn in the managed
                   Avalonia layer, so unpinning a pane would make it invisible
                   the moment it crossed the viewport - the most inviting glyph
                   in the header would be a trap. -->
              <dm:ToolDock Id="MapsDock" Alignment="Top" Proportion="0.085">
                <dm:Tool x:Name="MapsTool" Id="Maps" Title="Levels" CanClose="False" CanPin="False" />
              </dm:ToolDock>
              <dm:ProportionalDockSplitter />
              <dm:ToolDock Id="SceneDock" Alignment="Left" Proportion="0.89">
                <dm:Tool x:Name="SceneTool" Id="Scene" Title="Scene" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>

        <!-- The splitter's ink is one pixel; its HIT AREA is nine, which is
             what makes it draggable by a hand rather than by a surgeon. The
             ink is the column beside it.

             AND THE TRANSPARENT FILL NOW COMES FROM THE STYLE. Setting it here
             wrote a LocalValue, which outranks a StyleTrigger, so the
             GridSplitter:pointerover rule in Controls.axaml never fired on
             either of the two controls in this window a user drags most. The
             ink carries the hover instead, driven from code because a child
             cannot read its parent's pseudo-classes from a selector. -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Cursor="SizeWestEast"
                      Width="9" Margin="-4,0" PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      Tag="{Binding #LeftSplitInk}" />
        <Border x:Name="LeftSplitInk" Grid.Column="1" Width="1" Classes="splitink"
                HorizontalAlignment="Center" />

        <!-- MinWidth is not cosmetic: dragging the splitter to zero can leave
             the swap chain unable to recover. The viewport control itself is
             created in code when a session launches and removed when it closes,
             because a NativeControlHost's child window lives exactly as long as
             the control is in the visual tree.

             The bezel is the darkest surface in the window and the only place
             allowed near-black: chrome, then bezel, then render, so the picture
             is framed rather than butted straight against a panel. -->
        <Border x:Name="ViewportHost" Grid.Column="2" MinWidth="360"
                Background="{StaticResource SpectraViewportBezel}" />

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Cursor="SizeWestEast"
                      Width="9" Margin="-4,0" PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      Tag="{Binding #RightSplitInk}" />
        <Border x:Name="RightSplitInk" Grid.Column="3" Width="1" Classes="splitink"
                HorizontalAlignment="Center" />

        <dock:DockControl x:Name="RightDock" Grid.Column="4" InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="RightRoot" Id="RightRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #RightLayout}">
            <dm:ProportionalDock x:Name="RightLayout" Id="RightLayout" Orientation="Vertical">
              <dm:ToolDock Id="PropertiesDock" Alignment="Right" Proportion="1">
                <dm:Tool x:Name="PropertiesTool" Id="Properties" Title="Properties" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
      </Grid>
    </Panel>

    <!-- ============ Status bar =========================
         Left is the message zone, which the pump never overwrites. Right is
         the continuous cluster: every field is LABELLED, because "858x804" and
         "editor freelook" beside each other in monospace is a log line, not a
         status bar, and each is fixed-width so nothing jitters. -->
    <Border Grid.Row="3"
            Height="{StaticResource SpectraStatusBarHeight}"
            Background="{StaticResource SpectraBgApp}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconWarning}"
                Stroke="{StaticResource SpectraAccent}" StrokeThickness="1.3"
                Stretch="Uniform" IsVisible="{Binding IsError}" />
          <TextBlock Classes="statusmsg" Classes.errormsg="{Binding IsError}"
                     Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasSession}">
          <!-- A STANDING failure, in its own slot so nothing can overwrite it.
               A brush whose placement stopped being rigid makes every later
               compile defective, and the only symptom is that editing the level
               no longer changes what you see. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasWorldDefect}"
                      ToolTip.Tip="{Binding WorldDefectTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="level not rebuilding"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" />
          </StackPanel>
          <TextBlock Classes="value" Text="{Binding SelectionLabel}" MinWidth="104"
                     Foreground="{StaticResource SpectraTextEmphasis}" />
          <Border Classes="groupsep" />
          <TextBlock Classes="label" Text="camera" Margin="0,0,6,0" />
          <TextBlock Classes="value" Text="{Binding Navigation}" MinWidth="96"
                     ToolTip.Tip="Which camera drives the viewport  (F7)" />
          <Border Classes="groupsep" />
          <TextBlock Classes="value" Text="{Binding NodeCountLabel}"
                     Foreground="{StaticResource SpectraTextMuted}" MinWidth="70"
                     ToolTip.Tip="Nodes in the scene" />
          <Border Classes="groupsep" />
          <TextBlock Classes="label" Text="viewport" Margin="0,0,6,0" />
          <TextBlock Classes="value" Text="{Binding ViewportLabel}"
                     Foreground="{StaticResource SpectraTextMuted}" MinWidth="66" />
          <Border Classes="groupsep" />
          <TextBlock Classes="value frametime" Classes.overbudget="{Binding FrameTimeOverBudget}"
                     Text="{Binding FpsLabel}" MinWidth="58"
                     ToolTip.Tip="{Binding FrameTimeLabel}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
