<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:SpectraEngine.Editor.Viewport"
        xmlns:local="clr-namespace:SpectraEngine.Editor"
        xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
        x:Class="SpectraEngine.Editor.MainWindow"
        x:DataType="shell:ShellModel"
        Title="Spectra Editor"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource SpectraBgApp}">

  <!--
    Every row is its OWN grid cell and none of them overlap the viewport.

    That is a hard constraint, not a layout preference: the viewport is a native
    child window that always composites above anything Avalonia draws, so a
    floating toolbar, an overlay, a drop shadow or a popup that extended over
    it would simply be invisible there. Docked strips are what this shell can
    have, so they are what it has.
  -->

  <Window.Resources>
    <shell:SceneNodeKindIconConverter x:Key="KindIcon" />
    <shell:SceneNodeKindBrushConverter x:Key="KindTint" />
    <shell:TreeDepthIndentConverter x:Key="DepthIndent" />
  </Window.Resources>

  <Window.Styles>
    <!-- Tree rows. Selection and hover are drawn here, from model state and
         the pointer, because Fluent's own row highlight is a different shape
         and would sit underneath this one. -->
    <!-- The list draws none of its own row chrome: every state the row has is
         drawn by the template below, from model state and the pointer. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <!-- Every state, named explicitly. Fluent hangs the row fill on the
         template's presenter and picks it per state, so a single transparent
         setter is beaten the moment the row is selected or hovered: the system
         accent comes through as a bright bar the theme never chose. -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The expander. A button rather than a glyph, because it is one, and
         hidden rather than disabled on a node with nothing under it. -->
    <Style Selector="Button.chevron">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="{StaticResource SpectraTreeRowHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.chevron Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Button.chevron:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.chevron.open Path">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadius2}" />
      <Setter Property="Height" Value="{StaticResource SpectraTreeRowHeight}" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <!-- The 2px accent bar is what makes a selected row unmistakable at a
         glance down a long list; the fill alone is too quiet at 16% and too
         loud above it. -->
    <Style Selector="Border.selbar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.selected Border.selbar">
      <Setter Property="Background" Value="{StaticResource SpectraAccent}" />
    </Style>

    <Style Selector="TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.row.selected TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <!-- Filtered out, not hidden: removing rows collapses the hierarchy around
         every match and destroys the only thing a user has after two hundred
         nodes, which is knowing where things live. -->
    <Style Selector="Border.row.dim TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Border.row.dim Path">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="Border.row.context TextBlock.rowname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sep">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraBorderStrong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Text" Value="│" />
    </Style>
    <Style Selector="TextBlock.overbudget">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="TextBlock.errormsg">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- A 1px vertical rule between toolbar groups. Solid hex, never alpha:
         an alpha hairline resolves differently over each surface it crosses. -->
    <Style Selector="Border.groupsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{StaticResource SpectraBorderStrong}" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ═══ Menu ═════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="{StaticResource SpectraBgPanel}">
      <Menu VerticalAlignment="Center">
        <!--
          The File dropdown falls over the SCENE TREE, not the viewport, because
          the menu bar sits at the left of the window and the tree column is 280
          wide. That is load-bearing rather than lucky: the viewport is a native
          child window that composites above anything Avalonia draws, so a
          dropdown that reached across it would be invisible from wherever it
          crossed the edge. Anything wider than the tree column has to become a
          modal window instead.
        -->
        <MenuItem Header="_File">
          <MenuItem Header="_New map" InputGesture="Ctrl+N" Click="OnNewMapClicked" />
          <Separator />
          <MenuItem Header="_Open map..." InputGesture="Ctrl+O" Click="OnOpenMapClicked" />
          <MenuItem Header="Open _project..." Click="OnOpenProjectClicked" />
          <Separator />
          <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" />
          <MenuItem Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" />
          <Separator />
          <MenuItem Header="E_xit" Click="OnExitClicked" />
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}" />
          <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}" />
          <Separator />
          <MenuItem Header="_Duplicate" InputGesture="Ctrl+D" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}" />
          <MenuItem Header="De_lete" InputGesture="Delete" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}" />
          <Separator />
          <MenuItem Header="_Group" InputGesture="Ctrl+G" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}" />
          <MenuItem Header="U_ngroup" InputGesture="Ctrl+Shift+G" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}" />
          <Separator />
          <MenuItem Header="Convert brush kind" InputGesture="Ctrl+T" Click="OnToggleBrushKindClicked" IsEnabled="{Binding HasSelection}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Frame selection" InputGesture="F" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}" />
          <MenuItem Header="Toggle _navigation model" InputGesture="F7" Click="OnToggleNavigationClicked" />
          <Separator />
          <MenuItem Header="Focus _viewport" Click="OnFocusViewportClicked" />
        </MenuItem>
      </Menu>
    </Border>

    <!-- ═══ Toolbar ══════════════════════════════════════
         Fourteen controls is the ceiling; nothing goes in without something
         coming out. Space and style stay permanently visible because they are
         silent modifiers: they change what the NEXT drag does with no other
         signal, which makes them the top two sources of "why did it move like
         that". -->
    <Border Grid.Row="1"
            Height="{StaticResource SpectraToolbarHeight}"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="tool" Classes.active="{Binding IsMoveActive}" Click="OnMoveClicked" ToolTip.Tip="Move  (2)">
            <Path Data="{StaticResource IconMove}" />
          </Button>
          <Button Classes="tool" Classes.active="{Binding IsRotateActive}" Click="OnRotateClicked" ToolTip.Tip="Rotate  (4)">
            <Path Data="{StaticResource IconRotate}" />
          </Button>
          <Button Classes="tool" Classes.active="{Binding IsResizeActive}" Click="OnResizeClicked" ToolTip.Tip="Resize  (3)">
            <Path Data="{StaticResource IconResize}" />
          </Button>

          <Border Classes="groupsep" />

          <Button Classes="chip" Content="{Binding Orientation}" Click="OnOrientationClicked"
                  ToolTip.Tip="Axis frame drags resolve against  (X)" />
          <Button Classes="chip" Content="{Binding GizmoStyle}" Click="OnStyleClicked"
                  ToolTip.Tip="Handle roster and what a resize holds still  (Y)" />

          <Border Classes="groupsep" />

          <Button Classes="tool" Classes.active="{Binding SnapEnabled}" Click="OnSnapClicked"
                  ToolTip.Tip="Snap  (G),  finer / coarser with [ and ]">
            <Path Data="{StaticResource IconSnap}" />
          </Button>
          <TextBlock Classes="value" Text="{Binding SnapLabel}" Margin="2,0,0,0" MinWidth="86"
                     Foreground="{StaticResource SpectraTextMuted}" />

          <Border Classes="groupsep" />

          <Button Classes="tool" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo  (Ctrl+Z)">
            <Path Data="{StaticResource IconUndo}" />
          </Button>
          <Button Classes="tool" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo  (Ctrl+Y)">
            <Path Data="{StaticResource IconRedo}" />
          </Button>

          <Border Classes="groupsep" />

          <Button Classes="tool" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Duplicate  (Ctrl+D)">
            <Path Data="{StaticResource IconDuplicate}" />
          </Button>
          <Button Classes="tool" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Group  (Ctrl+G)">
            <Path Data="{StaticResource IconGroupNodes}" />
          </Button>
          <Button Classes="tool" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Ungroup  (Ctrl+Shift+G)">
            <Path Data="{StaticResource IconUngroupNodes}" />
          </Button>
          <Button Classes="tool" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Delete  (Del)">
            <Path Data="{StaticResource IconDelete}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="value" Text="{Binding Navigation}" Foreground="{StaticResource SpectraTextMuted}" Margin="0,0,8,0" />
          <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Frame selection  (F)">
            <Path Data="{StaticResource IconFrame}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Scene panel | viewport | inspector ═══════════
         DOCKED, all of it. The viewport is a native child window and
         composites above anything Avalonia draws, so a floating inspector, a
         drop shadow or a popup that reached across it would be invisible from
         wherever it crossed the edge. Every panel owns its own grid cell and
         none of them intersect the viewport's. -->
    <Grid Grid.Row="2" ColumnDefinitions="280,1,*,1,300">

      <DockPanel Grid.Column="0" Background="{StaticResource SpectraBgPanel}">

        <!-- The panel header carries the site's motif honestly: a category
             chip and a monospace name that refers to something real. No
             minimise/maximise/close glyphs — a dead close button teaches
             within one session that this app's controls are decorative, and
             making them true is a docking feature, not a paint job. -->
        <Border DockPanel.Dock="Top"
                Height="{StaticResource SpectraPanelHeaderHeight}"
                BorderBrush="{StaticResource SpectraBorderStrong}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                    Background="{StaticResource SpectraAccent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="scene.tree" Margin="8,0,0,0"
                       FontFamily="{StaticResource SpectraFontMono}"
                       FontSize="{StaticResource SpectraFontSecondary}"
                       Foreground="{StaticResource SpectraTextBody}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="value" Text="{Binding TreeCountLabel}"
                       Foreground="{StaticResource SpectraTextMuted}" />
          </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="8,8,8,6" ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" x:Name="FilterBox" Classes="filter"
                   Text="{Binding FilterText, Mode=TwoWay}"
                   PlaceholderText="Filter, or t:light"
                   KeyDown="OnFilterKeyDown" />
          <Button Grid.Column="1" Classes="tool" Width="24" Height="24" Margin="4,0,0,0"
                  Click="OnClearFilterClicked" IsVisible="{Binding HasFilter}"
                  ToolTip.Tip="Clear filter  (Esc)">
            <Path Data="{StaticResource IconClear}" Width="11" Height="11" />
          </Button>
        </Grid>

        <!--
          A flat list, not a tree control. A TreeView realises a container per
          node whether or not it can be seen, which at this engine's own ceiling
          of 25,000 nodes means building twenty-five thousand rows to show
          thirty-five. The model flattens to the visible rows and carries each
          one's depth, so the panel virtualizes like any list and the indent is
          a margin.
        -->
        <ListBox x:Name="SceneTree"
                 ItemsSource="{Binding Tree.Rows}"
                 SelectionChanged="OnTreeSelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,2,0,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- The default panel already, named so the realisation buffer can
                   be set: it defaults to zero, which realises exactly the
                   visible rows and pops one in at each edge as you scroll. Half
                   a viewport either side costs about thirty more rows. -->
              <VirtualizingStackPanel CacheLength="0.5" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:SceneTreeNode">
              <Border Classes="row"
                      Classes.selected="{Binding IsSelected}"
                      Classes.dim="{Binding IsDimmed}"
                      Classes.context="{Binding IsContext}"
                      Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                <Grid ColumnDefinitions="2,14,Auto,*">
                  <Border Grid.Column="0" Classes="selbar" Margin="0,3" CornerRadius="1" />
                  <Button Grid.Column="1" Classes="chevron"
                          Classes.open="{Binding IsExpanded}"
                          IsVisible="{Binding HasChildren}"
                          Click="OnChevronClicked" PointerPressed="OnChevronPressed">
                    <Path Data="{StaticResource IconChevronRight}" />
                  </Button>
                  <Path Grid.Column="2"
                        Data="{Binding Kind, Converter={StaticResource KindIcon}}"
                        Stroke="{Binding Kind, Converter={StaticResource KindTint}}"
                        StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                        Fill="Transparent" Width="14" Height="14" Stretch="Uniform"
                        Margin="2,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Classes="rowname" Text="{Binding Name}" Margin="6,0,4,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- MinWidth is not cosmetic: dragging the splitter to zero can leave
           the swap chain unable to recover. -->
      <Border Grid.Column="2" MinWidth="360"
              Background="{StaticResource SpectraBgApp}">
        <viewport:EngineViewport x:Name="Viewport" />
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <DockPanel Grid.Column="4" Background="{StaticResource SpectraBgPanel}">

        <Border DockPanel.Dock="Top"
                Height="{StaticResource SpectraPanelHeaderHeight}"
                BorderBrush="{StaticResource SpectraBorderStrong}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                    Background="{StaticResource SpectraAccent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="node.properties" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource SpectraFontMono}"
                       FontSize="{StaticResource SpectraFontSmall}"
                       Foreground="{StaticResource SpectraTextEmphasis}" />
            <TextBlock Grid.Column="2" Classes="value" VerticalAlignment="Center"
                       Text="{Binding SelectionLabel}"
                       Foreground="{StaticResource SpectraTextMuted}" />
          </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="12,16"
                   Text="{Binding Properties.EmptyLabel}"
                   Foreground="{StaticResource SpectraTextMuted}"
                   FontSize="{StaticResource SpectraFontSmall}"
                   IsVisible="{Binding !Properties.HasSelection}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Properties.HasSelection}">
          <ItemsControl ItemsSource="{Binding Properties.Groups}" Margin="0,4,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,8,0,0">

                  <!-- The section header is the GROUP, which the inspector
                       derives from the payload each value came from rather
                       than being told. A node with no light simply has no
                       Light section. -->
                  <TextBlock Text="{Binding Name}" Margin="10,0,10,4"
                             FontSize="{StaticResource SpectraFontMicro}"
                             Foreground="{StaticResource SpectraTextMuted}" />

                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="104,*" Margin="10,1">

                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{StaticResource SpectraFontSmall}"
                                       Foreground="{StaticResource SpectraTextBody}"
                                       VerticalAlignment="Center" />
                            <!-- "3 of 5": editing a row only part of the
                                 selection carries is still a bulk edit, and the
                                 user is entitled to know how far it reaches. -->
                            <TextBlock Text="{Binding PartialLabel}" Margin="6,0,0,0"
                                       FontSize="{StaticResource SpectraFontMicro}"
                                       Foreground="{StaticResource SpectraTextMuted}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsPartial}" />
                          </StackPanel>

                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}"
                                        IsVisible="{Binding HasFields}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,4,0">
                                  <TextBlock Grid.Column="0" Text="{Binding Label}"
                                             IsVisible="{Binding HasLabel}"
                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                             FontFamily="{StaticResource SpectraFontMono}"
                                             FontSize="{StaticResource SpectraFontMicro}"
                                             Foreground="{StaticResource SpectraTextMuted}" />
                                  <TextBox Grid.Column="1"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           Watermark="{Binding Placeholder}"
                                           GotFocus="OnPropertyFieldFocused"
                                           LostFocus="OnPropertyFieldBlurred"
                                           KeyDown="OnPropertyFieldKeyDown"
                                           Padding="5,3"
                                           FontFamily="{StaticResource SpectraFontMono}"
                                           FontSize="{StaticResource SpectraFontSmall}"
                                           Background="{StaticResource SpectraBgInput}"
                                           Foreground="{StaticResource SpectraTextEmphasis}"
                                           BorderBrush="{StaticResource SpectraBorderSoft}"
                                           BorderThickness="1" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <CheckBox Grid.Column="1" IsChecked="{Binding Flag, Mode=TwoWay}"
                                    IsVisible="{Binding IsBoolean}"
                                    VerticalAlignment="Center" />

                          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                    SelectedItem="{Binding Choice, Mode=TwoWay}"
                                    IsVisible="{Binding IsChoice}"
                                    HorizontalAlignment="Stretch"
                                    FontSize="{StaticResource SpectraFontSmall}"
                                    Background="{StaticResource SpectraBgInput}" />

                          <TextBlock Grid.Column="1" Text="{Binding ReadOnlyText}"
                                     IsVisible="{Binding IsReadOnly}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     FontFamily="{StaticResource SpectraFontMono}"
                                     FontSize="{StaticResource SpectraFontMicro}"
                                     Foreground="{StaticResource SpectraTextMuted}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- ═══ Status bar ═══════════════════════════════════
         Left is the message zone, which the pump never overwrites. Right is
         the continuous cluster, each field fixed-width so nothing jitters, and
         ordered with the fastest-changing values leftmost so the eye does not
         have to scan to the window edge. -->
    <Border Grid.Row="3"
            Height="{StaticResource SpectraStatusBarHeight}"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="value"
                   Classes.errormsg="{Binding IsError}"
                   Text="{Binding Message}"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Classes="value" Text="{Binding SelectionLabel}" MinWidth="112" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding GizmoMode}" MinWidth="46" />
          <TextBlock Classes="value" Text="{Binding GizmoStyle}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="52" />
          <TextBlock Classes="value" Text="{Binding Orientation}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="42" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding SnapLabel}" MinWidth="86" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding ViewportLabel}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="76" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding FpsLabel}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="58" />
          <TextBlock Classes="value" Classes.overbudget="{Binding FrameTimeOverBudget}"
                     Text="{Binding FrameTimeLabel}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="66" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
