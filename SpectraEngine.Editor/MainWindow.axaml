<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:SpectraEngine.Editor.Viewport"
        xmlns:local="clr-namespace:SpectraEngine.Editor"
        xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
        x:Class="SpectraEngine.Editor.MainWindow"
        x:DataType="shell:ShellModel"
        Title="Spectra Editor"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource SpectraBgApp}">

  <!--
    Every row is its OWN grid cell and none of them overlap the viewport.

    That is a hard constraint, not a layout preference: the viewport is a native
    child window that always composites above anything Avalonia draws, so a
    floating toolbar, an overlay, a drop shadow or a popup that extended over
    it would simply be invisible there. Docked strips are what this shell can
    have, so they are what it has.
  -->

  <!-- The tree's row styles, converters and templates travel with the
       ScenePanel control now, so a docking layout can host it anywhere
       without the window donating styles. -->

  <Window.Styles>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sep">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraBorderStrong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Text" Value="│" />
    </Style>
    <!-- The resting tint is a CLASS, not a local attribute: a local Foreground
         outranks every style, so the overbudget colour below could never
         apply through it. Declared before .overbudget so the threshold state
         wins on order. -->
    <Style Selector="TextBlock.frametime">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="TextBlock.overbudget">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="TextBlock.errormsg">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- A 1px vertical rule between toolbar groups. Solid hex, never alpha:
         an alpha hairline resolves differently over each surface it crosses. -->
    <Style Selector="Border.groupsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{StaticResource SpectraBorderStrong}" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The play button's two faces: go is the success green (the brand red
         means selected here, and a red play button reads as record), stop is
         the accent because stopping IS the loud state. The disabled override
         comes LAST so it wins on order over both. -->
    <Style Selector="Button.playbtn Path.playglyph">
      <Setter Property="Stroke" Value="{StaticResource SpectraSuccess}" />
    </Style>
    <Style Selector="Button.playbtn Path.stopglyph">
      <Setter Property="Stroke" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="Button.playbtn:disabled Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ═══ Tab strip ════════════════════════════════════
         The command surface is TABBED, the direction Studio itself converged
         on: one slim strip of grouped controls per tab instead of a toolbar
         with a control-count ceiling. File stays a real menu at the far left,
         where its dropdown falls over the 280px tree column - the airspace
         rule that retired the Edit and View menus, whose flyouts would have
         opened past it and vanished into the viewport. Their verbs live in
         the strips now. Play sits OUTSIDE the tabs: stopping a run must never
         be two clicks away. -->
    <Border Grid.Row="0" Background="{StaticResource SpectraBgPanel}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Menu Grid.Column="0" VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem Header="New _project..." Click="OnNewProjectClicked" />
            <MenuItem Header="Open p_roject..." Click="OnOpenProjectClicked" />
            <MenuItem Header="_Close project" Click="OnCloseProjectClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="_New map" InputGesture="Ctrl+N" Click="OnNewMapClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="_Open map..." InputGesture="Ctrl+O" Click="OnOpenMapClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="E_xit" Click="OnExitClicked" />
          </MenuItem>
        </Menu>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0"
                    IsVisible="{Binding HasSession}">
          <Button Classes="tab" Classes.active="{Binding IsHomeTab}" Content="Home" Click="OnHomeTabClicked" />
          <Button Classes="tab" Classes.active="{Binding IsModelTab}" Content="Model" Click="OnModelTabClicked" />
          <Button Classes="tab" Classes.active="{Binding IsViewTab}" Content="View" Click="OnViewTabClicked" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" Margin="0,0,6,0"
                    IsVisible="{Binding HasSession}">
          <TextBlock Classes="value" Text="{Binding Navigation}"
                     Foreground="{StaticResource SpectraTextMuted}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="tool playbtn" Click="OnPlayClicked"
                  IsEnabled="{Binding CanPlay}" ToolTip.Tip="{Binding PlayTip}">
            <Panel>
              <Path Classes="playglyph" Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" />
              <Path Classes="stopglyph" Data="{StaticResource IconStop}" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Command strips ═══════════════════════════════
         One per tab, toggled by visibility so the row's height never moves.
         Silent modifiers (frame, style, snap) stay on Home, permanently
         visible while editing: they change what the NEXT drag does with no
         other signal. -->
    <Border Grid.Row="1"
            Height="{StaticResource SpectraToolbarHeight}"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1"
            IsVisible="{Binding HasSession}">
      <Panel Margin="8,0">

        <!-- ─── Home ─────────────────────────────────────── -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsHomeTab}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="tool" Classes.active="{Binding IsMoveActive}" Click="OnMoveClicked" ToolTip.Tip="Move  (2)">
              <Path Data="{StaticResource IconMove}" />
            </Button>
            <Button Classes="tool" Classes.active="{Binding IsRotateActive}" Click="OnRotateClicked" ToolTip.Tip="Rotate  (4)">
              <Path Data="{StaticResource IconRotate}" />
            </Button>
            <Button Classes="tool" Classes.active="{Binding IsResizeActive}" Click="OnResizeClicked" ToolTip.Tip="Resize  (3)">
              <Path Data="{StaticResource IconResize}" />
            </Button>

            <Border Classes="groupsep" />

            <Button Classes="chip" Content="{Binding Orientation}" Click="OnOrientationClicked"
                    ToolTip.Tip="Axis frame drags resolve against  (X)" />
            <Button Classes="chip" Content="{Binding GizmoStyle}" Click="OnStyleClicked"
                    ToolTip.Tip="Handle roster and what a resize holds still  (Y)" />

            <Border Classes="groupsep" />

            <Button Classes="tool" Classes.active="{Binding SnapEnabled}" Click="OnSnapClicked"
                    ToolTip.Tip="Snap  (G),  finer / coarser with [ and ]">
              <Path Data="{StaticResource IconSnap}" />
            </Button>
            <!-- Typed increments, one per tool because the units differ: move
                 and resize are world units, rotate is degrees. Enter or blur
                 commits, Escape reverts - the property panel's contract. -->
            <TextBlock Classes="label" Text="mv" Margin="6,0,3,0" />
            <TextBox x:Name="SnapMoveBox" Classes="snapfield"
                     GotFocus="OnSnapFieldFocused"
                     LostFocus="OnSnapFieldBlurred" KeyDown="OnSnapFieldKeyDown"
                     ToolTip.Tip="Move grid, world units" />
            <TextBlock Classes="label" Text="rot" Margin="6,0,3,0" />
            <TextBox x:Name="SnapRotateBox" Classes="snapfield"
                     GotFocus="OnSnapFieldFocused"
                     LostFocus="OnSnapFieldBlurred" KeyDown="OnSnapFieldKeyDown"
                     ToolTip.Tip="Rotate step, degrees" />
            <TextBlock Classes="label" Text="sz" Margin="6,0,3,0" />
            <TextBox x:Name="SnapResizeBox" Classes="snapfield"
                     GotFocus="OnSnapFieldFocused"
                     LostFocus="OnSnapFieldBlurred" KeyDown="OnSnapFieldKeyDown"
                     ToolTip.Tip="Resize step, world units" />

            <Border Classes="groupsep" />

            <Button Classes="tool" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo  (Ctrl+Z)">
              <Path Data="{StaticResource IconUndo}" />
            </Button>
            <Button Classes="tool" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo  (Ctrl+Y)">
              <Path Data="{StaticResource IconRedo}" />
            </Button>

            <Border Classes="groupsep" />

            <Button Classes="tool" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Duplicate  (Ctrl+D)">
              <Path Data="{StaticResource IconDuplicate}" />
            </Button>
            <Button Classes="tool" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Group  (Ctrl+G)">
              <Path Data="{StaticResource IconGroupNodes}" />
            </Button>
            <Button Classes="tool" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Ungroup  (Ctrl+Shift+G)">
              <Path Data="{StaticResource IconUngroupNodes}" />
            </Button>
            <Button Classes="tool" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Delete  (Del)">
              <Path Data="{StaticResource IconDelete}" />
            </Button>

            <Border Classes="groupsep" />

            <Button Classes="tool" Click="OnToggleBrushKindClicked" IsEnabled="{Binding HasSelection}"
                    ToolTip.Tip="Convert between world geometry and part  (Ctrl+T)">
              <Path Data="{StaticResource IconBrushPart}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Frame selection  (F)">
              <Path Data="{StaticResource IconFrame}" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- ─── Model ────────────────────────────────────── -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsModelTab}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <!-- The insert group: what a scene is built from. Each lands on
                 the surface in the middle of the view, snapped to the move
                 grid, selected, one undo entry. -->
            <TextBlock Classes="label" Text="insert" Margin="0,0,6,0" />
            <Button Classes="tool" Click="OnInsertWorldBrushClicked"
                    ToolTip.Tip="Insert a world brush: fused into the static world">
              <Path Data="{StaticResource IconBrushWorld}" />
            </Button>
            <Button Classes="tool" Click="OnInsertPartBrushClicked"
                    ToolTip.Tip="Insert a part: outside the carve, cheap to move and animate">
              <Path Data="{StaticResource IconBrushPart}" />
            </Button>
            <Button Classes="tool" Click="OnInsertSubtractiveBrushClicked"
                    ToolTip.Tip="Insert a hole: subtracts from the world geometry it overlaps">
              <Path Data="{StaticResource IconBrushSubtractive}" />
            </Button>
            <Button Classes="tool" Click="OnInsertLightClicked"
                    ToolTip.Tip="Insert a point light">
              <Path Data="{StaticResource IconLight}" />
            </Button>
            <Button Classes="tool" Click="OnInsertGroupClicked"
                    ToolTip.Tip="Insert an empty group">
              <Path Data="{StaticResource IconGroup}" />
            </Button>

            <Border Classes="groupsep" />

            <Button Classes="tool" Click="OnToggleBrushKindClicked" IsEnabled="{Binding HasSelection}"
                    ToolTip.Tip="Convert between world geometry and part  (Ctrl+T)">
              <Path Data="{StaticResource IconBrushPart}" />
            </Button>

            <Border Classes="groupsep" />

            <Button Classes="tool" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Duplicate  (Ctrl+D)">
              <Path Data="{StaticResource IconDuplicate}" />
            </Button>
            <Button Classes="tool" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Group  (Ctrl+G)">
              <Path Data="{StaticResource IconGroupNodes}" />
            </Button>
            <Button Classes="tool" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Ungroup  (Ctrl+Shift+G)">
              <Path Data="{StaticResource IconUngroupNodes}" />
            </Button>
            <Button Classes="tool" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Delete  (Del)">
              <Path Data="{StaticResource IconDelete}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Frame selection  (F)">
              <Path Data="{StaticResource IconFrame}" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- ─── View ─────────────────────────────────────── -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsViewTab}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <!-- Leftmost on purpose: this is the strip's one dropdown, and
                 from here its popup falls over the tree column rather than
                 the viewport, where it would be invisible. -->
            <TextBlock Classes="label" Text="pipeline" Margin="0,0,6,0" />
            <ComboBox Width="110"
                      ItemsSource="{Binding PipelineNames}"
                      SelectedItem="{Binding PipelineName, Mode=TwoWay}"
                      FontSize="{StaticResource SpectraFontSmall}"
                      Background="{StaticResource SpectraBgInput}"
                      ToolTip.Tip="Rendering pipeline  (F6 cycles)" />

            <Border Classes="groupsep" />

            <Button Classes="chip" Classes.active="{Binding DebugWireframe}" Content="wire"
                    Click="OnDebugWireClicked" ToolTip.Tip="Wireframe overlay  (F1)" />
            <Button Classes="chip" Classes.active="{Binding DebugVertices}" Content="verts"
                    Click="OnDebugVerticesClicked" ToolTip.Tip="CSG vertex markers  (F2)" />
            <Button Classes="chip" Classes.active="{Binding DebugAabbs}" Content="aabbs"
                    Click="OnDebugAabbsClicked" ToolTip.Tip="Bounds overlay  (F3)" />
            <Button Classes="chip" Classes.active="{Binding DebugNormals}" Content="normals"
                    Click="OnDebugNormalsClicked" ToolTip.Tip="Face normals  (F4)" />
            <Button Classes="chip" Classes.active="{Binding DebugSceneGraph}" Content="graph"
                    Click="OnDebugSceneGraphClicked" ToolTip.Tip="Node axes and parent links  (F5)" />

            <Border Classes="groupsep" />

            <Button Classes="chip" Content="{Binding Navigation}" Click="OnToggleNavigationClicked"
                    ToolTip.Tip="Which camera drives the viewport  (F7)" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Frame selection  (F)">
              <Path Data="{StaticResource IconFrame}" />
            </Button>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>

    <!-- ═══ Start page | editor ═══════════════════════════
         Two states of one row. The start page shows while NO engine session
         exists, which is the only time free layout is possible at all: the
         viewport's native child window is created when a session launches and
         composites above anything Avalonia draws from then on. The code
         behind switches the two explicitly, because the viewport must leave
         the tree BEFORE the editor view hides, never after. -->
    <Panel Grid.Row="2">

      <shell:StartPage x:Name="StartView" />

      <!-- ═══ Scene panel | viewport | inspector ═══════════
           DOCKED, all of it. The viewport is a native child window and
           composites above anything Avalonia draws, so a floating inspector, a
           drop shadow or a popup that reached across it would be invisible from
           wherever it crossed the edge. Every panel owns its own grid cell and
           none of them intersect the viewport's. -->
      <Grid x:Name="EditorView" IsVisible="False" ColumnDefinitions="280,1,*,1,300">

        <!-- The left column stacks the project's maps over the scene tree;
             each panel is self-contained (styles, templates, handlers), which
             is what lets a docking layout later host them anywhere. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
          <shell:MapsPanel x:Name="MapsView" Grid.Row="0" IsVisible="{Binding HasProject}" />
          <shell:ScenePanel x:Name="SceneView" Grid.Row="1" />
        </Grid>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- MinWidth is not cosmetic: dragging the splitter to zero can leave
             the swap chain unable to recover. The viewport control itself is
             created in code when a session launches and removed when it
             closes, because a NativeControlHost's child window lives exactly
             as long as the control is in the visual tree. -->
        <Border x:Name="ViewportHost" Grid.Column="2" MinWidth="360"
                Background="{StaticResource SpectraBgApp}" />

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

        <shell:PropertiesPanel x:Name="PropertiesView" Grid.Column="4" />
      </Grid>
    </Panel>

    <!-- ═══ Status bar ═══════════════════════════════════
         Left is the message zone, which the pump never overwrites. Right is
         the continuous cluster, each field fixed-width so nothing jitters, and
         ordered with the fastest-changing values leftmost so the eye does not
         have to scan to the window edge. -->
    <Border Grid.Row="3"
            Height="{StaticResource SpectraStatusBarHeight}"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="value"
                   Classes.errormsg="{Binding IsError}"
                   Text="{Binding Message}"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasSession}">
          <TextBlock Classes="value" Text="{Binding SelectionLabel}" MinWidth="112" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding GizmoMode}" MinWidth="46" />
          <TextBlock Classes="value" Text="{Binding GizmoStyle}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="52" />
          <TextBlock Classes="value" Text="{Binding Orientation}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="42" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding SnapLabel}" MinWidth="86" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding ViewportLabel}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="76" />
          <TextBlock Classes="sep" />
          <TextBlock Classes="value" Text="{Binding FpsLabel}" Foreground="{StaticResource SpectraTextMuted}" MinWidth="58" />
          <TextBlock Classes="value frametime" Classes.overbudget="{Binding FrameTimeOverBudget}"
                     Text="{Binding FrameTimeLabel}" MinWidth="66" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
