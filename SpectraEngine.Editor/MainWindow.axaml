<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:SpectraEngine.Editor.Viewport"
        xmlns:local="clr-namespace:SpectraEngine.Editor"
        xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dm="clr-namespace:Dock.Model.Avalonia.Controls;assembly=Dock.Model.Avalonia"
        x:Class="SpectraEngine.Editor.MainWindow"
        x:DataType="shell:ShellModel"
        Title="Spectra Editor"
        Width="1480" Height="920"
        MinWidth="1180" MinHeight="640"
        Background="{StaticResource SpectraBgApp}">

  <!--
    Four rows, none of which overlaps the viewport.

    THE AIRSPACE RULE BINDS A NATIVE SESSION AND IS VOID FOR A COMPOSITED ONE.
    A native viewport is a child window and composites above everything Avalonia
    draws INTO THIS WINDOW: an overlay, an adorner, a drop shadow or a dock float
    drawn in the managed layer is invisible wherever it crosses the viewport's
    cell. A POPUP is a different thing, and this was measured rather than
    reasoned about. On Windows an Avalonia popup is a real OS window, so context
    menus, menu flyouts, combo dropdowns, tooltips and modal dialogs all
    composite ABOVE the native child - proven with a tree row's context menu
    opening 300px out over live 3D. A composited viewport has no child window at
    all: it is a control over a CompositionSurfaceVisual, so nothing in this
    paragraph applies to it and the layout below simply stops constraining
    itself. Which one a session got is never guessed at twice - see
    ViewportLayout.

    That is why this window has five menus. The previous shell had one, and
    retired Edit and View on the reasoning that their flyouts would open past
    the 280px tree column and vanish; the reasoning was sound and the premise
    was wrong. Menus are the cheapest way to make every verb reachable a second
    way with its shortcut printed beside it, which is the single largest
    discoverability change available here.

    ONE command row, not a tab strip. The strip was three tabs whose Home and
    Model pages carried the same six verbs and whose Frame button was written
    out three times, so switching mostly did nothing and taught the user the
    tabs were decorative - while the one thing a first session actually needs,
    inserting an object, sat on the tab nobody opened. The structural verbs
    (duplicate, group, ungroup, delete) left the bar entirely: they were four
    anonymous glyphs, and they are on the keyboard, in the Object menu and in
    every row's context menu already.
  -->

  <Window.Styles>
    <!-- The document identity in the menu row. -->
    <Style Selector="TextBlock.docname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.docproject">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The status bar's message zone. Prose, so it is set in the UI face:
         these are whole sentences and they used to be rendered in 11px
         Cascadia Mono. -->
    <Style Selector="TextBlock.statusmsg">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statusmsg.errormsg">
      <Setter Property="Foreground" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- The resting tint is a CLASS, not a local attribute: a local Foreground
         outranks every style, so the over-budget colour below could never
         apply through it. Declared before .overbudget so the threshold state
         wins on order. -->
    <Style Selector="TextBlock.frametime">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="TextBlock.overbudget">
      <Setter Property="Foreground" Value="{StaticResource SpectraWarning}" />
    </Style>

    <!-- The play button. Filled glyphs, and the two faces are the only place
         in the shell that spends a semantic colour on a control: success green
         to start (the brand red means SELECTED here, and a red play button
         reads as record), accent to stop, because stopping is the loud state.
         The disabled override comes LAST so it wins on order over both. -->
    <Style Selector="Button.playbtn">
      <Setter Property="Height" Value="{StaticResource SpectraControlHeight}" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.playbtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>
    <Style Selector="Button.playbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    </Style>
    <!-- The word needs its own rule: the global TextBlock style out-ranks the
         Foreground a label would inherit from its button, so the setters on
         the button itself never recolour it. Same mechanism, same fix, as the
         seg labels in Controls.axaml. -->
    <Style Selector="Button.playbtn TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.playbtn Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraSuccess}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraSuccess}" />
    </Style>
    <Style Selector="Button.playbtn Path.stopglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraAccent}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="Button.playbtn:disabled Path">
      <Setter Property="Fill" Value="{StaticResource SpectraTextDisabled}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Button.playbtn:disabled">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Button.playbtn:disabled TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>

    <!-- The command bar wears the mode colour while play owns the scene: the
         strongest "this is a live engine" moment the product has used to leave
         the chrome pixel-identical, so the greyed Insert cluster read as
         broken rather than as suspended. -->
    <Style Selector="Border.cmdbar">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cmdbar.playing">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
    </Style>

    <!-- A standing amber chip: a latched viewport overlay with no standing
         indicator is a viewport that looks broken to whoever fat-fingered F1.
         Clicking one turns exactly that overlay off. -->
    <Style Selector="Button.overlaychip">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlaychip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.overlaychip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    </Style>
    <Style Selector="Button.overlaychip TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    </Style>

    <!-- ============ The drop overlay ==================
         THE FIRST THING THIS SHELL DRAWS OVER THE RENDER, and the whole of what
         makes it possible is that a composited pane has no child window in it.
         The markup below is unremarkable Avalonia; over a native child every
         pixel of it would be painted and then composited away, which is the
         airspace rule and the reason nothing like this could ship until now.
         ViewportDropPrompt refuses to be visible in a native session for that
         exact reason - see its remarks.

         AMBER, NOT THE ACCENT. The accent means SELECTION here and one thing
         only, and a drop target selects nothing; the palette's own history is
         that red once meant selected, live tool, focus, primary, error, drop
         target and no-match at once, and untangling it is what stopped the
         window reading as monochrome-plus-one. What this says is "the viewport
         is in a state where letting go does something", which is the definition
         SpectraMode carries - the live gizmo tool, snap on, the standing
         overlay chips eighteen lines above this. And the refusing arm is a
         WARNING, which is deliberately the same amber told apart by its icon
         and its place: one hue for one affordance, with the words carrying the
         difference, rather than two colours to learn for one gesture.

         NOT HIT TEST VISIBLE, and that one is a silent killer. This element is
         in the tree at all times with its opacity at zero; hit-testable, it
         would sit between the pointer and the viewport, so DragOver would be
         raised on IT and bubble to the window instead of reaching the pane -
         the effect would go to None, the drop would never land, and there is no
         error anywhere in that. -->
    <Style Selector="Border.dropoverlay">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="Background" Value="{StaticResource SpectraDropWash}" />
      <!-- The ONE transition here, and it is on the appear and the disappear
           because those are the only two things that move. Nothing in this
           overlay follows the cursor: the frame is the pane and the chip is
           pinned under the header, so there is no value a pointer writes per
           frame and therefore no lag machine to build. A badge that tracked the
           pointer would have to carry no transition at all, exactly like the
           tree's drop ink, and it would still obscure the point being aimed at.

           One duration in both directions rather than the faster exit the
           budget prefers: expressing that means re-declaring Transitions inside
           the state frame and relying on the order Avalonia applies and reverts
           setters when one deactivates, which is not a guarantee it makes. A
           55ms exit that is sometimes 90 is a coin flip, not a choice. -->
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="{StaticResource SpectraMotionFast}"
                            Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dropoverlay.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Chrome over the picture, so it is opaque and wears a chrome surface.
         A translucent label over a render is unreadable against whatever
         happens to be behind it, which for a viewport is anything at all. -->
    <Style Selector="Border.dropchip">
      <Setter Property="Background" Value="{StaticResource SpectraBgApp}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- Every one of these names Foreground explicitly, and none of them may
         stop. The global bare-TextBlock style sets it at StyleTrigger's
         expense, so a colour inherited from the chip is beaten by a selector
         that names no class and the label arrives body-grey - the mechanism
         that has silently eaten hover states in this window four times. A
         class in the selector is what wins the tie. -->
    <Style Selector="Border.dropchip Path.dropicon">
      <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
    </Style>
    <Style Selector="Border.dropchip TextBlock.dropheadline">
      <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Mono, because this is a VALUE: it is the content-relative path, the
         string the asset caches, the map codec and the pack's id hash all key
         on, and seeing it is how somebody knows the drag is carrying what they
         think it is. -->
    <Style Selector="Border.dropchip TextBlock.dropsubject">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.dropchip TextBlock.dropreason">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- A field that lives INSIDE a raised cluster: sunken fill so it still
         reads as somewhere you type, no resting border because the capsule
         around it already draws one, and an accent border while focused. -->
    <Style Selector="TextBox.field.inline">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBgInput}" />
    </Style>
    <Style Selector="TextBox.field.inline /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBgInput}" />
    </Style>
    <Style Selector="TextBox.field.inline:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    </Style>
    <Style Selector="TextBox.field.inline:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ============ Menu row ==========================
         Five menus, then the document's identity and Play at the far right.
         Play is here rather than in the command row so it never moves and is
         never one of a crowd: stopping a run must be the easiest thing on
         screen to hit. -->
    <Border Grid.Row="0"
            Height="{StaticResource SpectraMenuBarHeight}"
            Background="{StaticResource SpectraBgApp}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- 6 + the Menu's own 4 padding puts the first pill at x=10, the same
             left rail as the command bar and the status bar below it. -->
        <Menu Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0">

          <MenuItem Header="_File">
            <MenuItem Header="_New project..." Click="OnNewProjectClicked" />
            <MenuItem Header="_Open project..." Click="OnOpenProjectClicked" />
            <!-- Populated in code from the same recents the start page shows:
                 a menu built from settings at open time cannot drift from the
                 list. Items land BEFORE the trailing clear entry. -->
            <MenuItem Header="Recent p_rojects" x:Name="RecentProjectsMenu">
              <MenuItem Header="(nothing yet)" IsEnabled="False" x:Name="RecentProjectsEmptyItem" />
              <Separator x:Name="RecentProjectsSeparator" />
              <MenuItem Header="Clear list" Click="OnClearRecentsClicked" x:Name="RecentProjectsClearItem" />
            </MenuItem>
            <MenuItem Header="_Close project" Click="OnCloseProjectClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="New _level" InputGesture="Ctrl+N" Click="OnNewMapClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Open _level..." InputGesture="Ctrl+O" Click="OnOpenMapClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <!-- Cooks the project and mounts the pack ALONE and strict, which is
                 the only way to see what a shipped build sees: the editor
                 resolves loose files above the pack, so a texture the cook never
                 produced looks perfectly fine in this window. -->
            <MenuItem Header="_Validate cooked content" Click="OnValidateCookedClicked"
                      IsEnabled="{Binding CanValidateCooked}"
                      ToolTip.Tip="Cook this project and check the pack resolves with nothing else mounted." />
            <Separator />
            <MenuItem Header="E_xit" Click="OnExitClicked" />
          </MenuItem>

          <MenuItem Header="_Edit" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUndo}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRedo}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Move tool" InputGesture="W" Click="OnMoveClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconMove}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Rotate tool" InputGesture="E" Click="OnRotateClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRotate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Size tool" InputGesture="R" Click="OnResizeClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconResize}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Snap to grid" InputGesture="G" Click="OnSnapClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGrid}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Finer grid" InputGesture="OemOpenBrackets" Click="OnSnapFinerClicked" />
            <MenuItem Header="Coarser grid" InputGesture="OemCloseBrackets" Click="OnSnapCoarserClicked" />
            <Separator />
            <MenuItem Header="{Binding OrientationMenuLabel}" InputGesture="X" Click="OnOrientationClicked" />
            <MenuItem Header="{Binding GizmoStyleMenuLabel}" InputGesture="Y" Click="OnStyleClicked" />
          </MenuItem>

          <!-- Everything that makes or changes an object. This is where a
               newcomer looks for "how do I add something", so Insert is the
               first item rather than buried under a tab. -->
          <MenuItem Header="_Object" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Insert block" InputGesture="Ctrl+D1" Click="OnInsertWorldBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-world" Data="{StaticResource IconBrushWorld}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert part" InputGesture="Ctrl+D2" Click="OnInsertPartBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-part" Data="{StaticResource IconBrushPart}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert cut" InputGesture="Ctrl+D3" Click="OnInsertSubtractiveBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-cut" Data="{StaticResource IconBrushSubtractive}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert light" InputGesture="Ctrl+D4" Click="OnInsertLightClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-light" Data="{StaticResource IconLight}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert surface light" Click="OnInsertSurfaceLightClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="A lit panel flat on the surface you are looking at, parented to it."><MenuItem.Icon><Path Classes="icon menuicon kind-light" Data="{StaticResource IconLight}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert empty group" Click="OnInsertGroupClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroup}" /></MenuItem.Icon></MenuItem>

            <!-- The one insert whose entries cannot be written down here: which
                 entity classes exist is read out of the session's .sentdef, so
                 the entries are BUILT IN CODE when the submenu opens, exactly
                 as the viewport's own "Insert here > Entity" builds them. One
                 mechanism rather than an ItemsSource here and a loop there:
                 binding the entries would need a ControlTheme over Fluent's
                 MenuItem theme, which this shell has no other instance of and
                 whose failure mode is a submenu of blank rows. Hidden entirely
                 when the catalogue is empty, rather than opening onto nothing. -->
            <MenuItem x:Name="InsertEntityMenu" Header="Insert entity"
                      IsVisible="{Binding HasEntityClasses}"
                      IsEnabled="{Binding !IsPlaying}"
                      SubmenuOpened="OnInsertEntityMenuOpened">
              <MenuItem.Icon><Path Classes="icon menuicon kind-entity" Data="{StaticResource IconEntity}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Duplicate" InputGesture="Ctrl+D" Click="OnDuplicateClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDuplicate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Delete" InputGesture="Delete" Click="OnDeleteClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDelete}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Group" InputGesture="Ctrl+G" Click="OnGroupClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Ungroup" InputGesture="Ctrl+Shift+G" Click="OnUngroupClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUngroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Convert block / part" InputGesture="Ctrl+T" Click="OnToggleBrushKindClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconConvertKind}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Frame in viewport" InputGesture="F" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconFrame}" /></MenuItem.Icon></MenuItem>
          </MenuItem>

          <MenuItem Header="_View" IsEnabled="{Binding HasSession}">
            <!-- Panels FIRST, because until this menu existed a user could
                 neither hide a panel nor discover that panels were a concept:
                 the dock chrome's close button was the only route, and closing
                 one was then permanent. -->
            <MenuItem Header="Panels">
              <MenuItem Header="Scene" Click="OnShowScenePanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroup}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Levels" Click="OnShowMapsPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconMap}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Properties" Click="OnShowPropertiesPanel" />
              <Separator />
              <MenuItem Header="Content" Click="OnShowContentPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconOpenFolder}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Output" Click="OnShowOutputPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconWarning}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Console" InputGesture="OemTilde" Click="OnShowConsolePanel" />
            </MenuItem>
            <Separator />

            <!-- Built in code from the backend's own pipeline list, radio
                 checked, because which pipelines exist depends on the
                 renderer that started. -->
            <MenuItem Header="Renderer" x:Name="RendererMenu" />
            <Separator />
            <MenuItem Header="Wireframe" InputGesture="F1" ToggleType="CheckBox"
                      IsChecked="{Binding DebugWireframe, Mode=OneWay}" Click="OnDebugWireClicked" />
            <MenuItem Header="CSG vertices" InputGesture="F2" ToggleType="CheckBox"
                      IsChecked="{Binding DebugVertices, Mode=OneWay}" Click="OnDebugVerticesClicked" />
            <MenuItem Header="Bounds" InputGesture="F3" ToggleType="CheckBox"
                      IsChecked="{Binding DebugAabbs, Mode=OneWay}" Click="OnDebugAabbsClicked" />
            <MenuItem Header="Face normals" InputGesture="F4" ToggleType="CheckBox"
                      IsChecked="{Binding DebugNormals, Mode=OneWay}" Click="OnDebugNormalsClicked" />
            <MenuItem Header="Node axes" InputGesture="F5" ToggleType="CheckBox"
                      IsChecked="{Binding DebugSceneGraph, Mode=OneWay}" Click="OnDebugSceneGraphClicked" />
            <Separator />
            <!-- Three SET verbs, never a cycle, like every state a control
                 displays; the checkmark follows the engine's echo. -->
            <MenuItem Header="Grid">
              <MenuItem Header="During move and resize" ToggleType="Radio"
                        IsChecked="{Binding GridAuto, Mode=OneWay}" Click="OnGridAutoClicked" />
              <MenuItem Header="Always" ToggleType="Radio"
                        IsChecked="{Binding GridOn, Mode=OneWay}" Click="OnGridOnClicked" />
              <MenuItem Header="Off" ToggleType="Radio"
                        IsChecked="{Binding GridOff, Mode=OneWay}" Click="OnGridOffClicked" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding NavigationMenuLabel}" InputGesture="F7" Click="OnToggleNavigationClicked" />

          </MenuItem>

          <MenuItem Header="_Help">
            <MenuItem Header="Keyboard reference" Click="OnKeyboardReferenceClicked" />
            <Separator />
            <MenuItem Header="{Binding AboutLabel}" IsEnabled="False" />
          </MenuItem>
        </Menu>

        <!-- With nothing open the bar carries the product's identity where the
             document cluster otherwise sits, so the start page needs no header
             of its own and the bar never changes height. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding !HasSession}">
          <Border Width="10" Height="10"
                  CornerRadius="{StaticResource SpectraRadiusControl}"
                  Background="{StaticResource SpectraAccent}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Spectra Editor" Classes="docname" />
          <TextBlock x:Name="VersionLabel" Classes="value"
                     Foreground="{StaticResource SpectraTextMuted}" />
        </StackPanel>

        <!-- WHAT AM I EDITING. The window title used to answer this with
             "Demo - Demo - Spectra Editor"; here the level is the loud half,
             the project is context, and the dot is the unsaved mark. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding HasSession}">
          <TextBlock Classes="docproject" Text="{Binding ProjectName}"
                     IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docproject" Text="/" IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docname" Text="{Binding DocumentName}" />
          <Border Width="6" Height="6" CornerRadius="3"
                  Background="{StaticResource SpectraWarning}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsDocumentDirty}"
                  ToolTip.Tip="Unsaved changes" />
          <!-- Inside a Spacing="8" run the separator's own 10px margin stacked
               to 18 a side; 2 restores the status bar's 10px rhythm. -->
          <Border Classes="groupsep" Margin="2,0" />
          <Button Classes="playbtn" Click="OnPlayClicked"
                  IsEnabled="{Binding CanPlay}" ToolTip.Tip="{Binding PlayTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel Width="16" Height="16">
                <Path Classes="icon playglyph" Data="{StaticResource IconPlay}"
                      StrokeThickness="0" IsVisible="{Binding !IsPlaying}" />
                <Path Classes="icon stopglyph" Data="{StaticResource IconStop}"
                      StrokeThickness="0" IsVisible="{Binding IsPlaying}" />
              </Panel>
              <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Command bar ========================
         One row of raised clusters. A cluster is one bordered capsule holding
         the controls of one decision, which is what makes grouping visible
         instead of implied by a hairline nobody notices. -->
    <Border Grid.Row="1" Classes="cmdbar" Classes.playing="{Binding IsPlaying}"
            Height="{StaticResource SpectraToolbarHeight}"
            Background="{StaticResource SpectraBgApp}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1"
            IsVisible="{Binding HasSession}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

          <!-- Tools. Labelled, not icon-only: this is the row a first session
               reads, and an icon-only strip is fast for the hand and mute for
               the eye. Roblox Studio labels every button in its ribbon and is
               right to. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.active="{Binding IsMoveActive}"
                      Click="OnMoveClicked" ToolTip.Tip="Move the selection.  2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconMove}" />
                  <TextBlock Text="Move" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Classes.active="{Binding IsRotateActive}"
                      Click="OnRotateClicked" ToolTip.Tip="Rotate the selection.  4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconRotate}" />
                  <TextBlock Text="Rotate" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Classes.active="{Binding IsResizeActive}"
                      Click="OnResizeClicked" ToolTip.Tip="Change the selection's size.  3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconResize}" />
                  <TextBlock Text="Size" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Snap. ONE field, not three: it holds the increment of whichever
               tool is live and says which unit that is, so the number in front
               of you always means the drag you are about to make. Three boxes
               labelled mv / rot / sz asked the user to keep a mapping in their
               head and abbreviated the three words that would have made it
               unnecessary. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.active="{Binding SnapEnabled}" Width="26" Padding="0"
                      Click="OnSnapClicked" ToolTip.Tip="Snap drags to the grid.  G">
                <Path Classes="icon" Data="{StaticResource IconGrid}" />
              </Button>
              <Border Classes="segsep" />
              <TextBox x:Name="SnapBox" Classes="field num inline" Width="54"
                       Margin="4,0,0,0" VerticalAlignment="Center"
                       GotFocus="OnSnapFieldFocused"
                       LostFocus="OnSnapFieldBlurred" KeyDown="OnSnapFieldKeyDown"
                       ToolTip.Tip="Grid size for the live tool. [ and ] step it." />
              <TextBlock Classes="label" Text="{Binding SnapUnitLabel}"
                         Margin="5,0,8,0" MinWidth="20" />
            </StackPanel>
          </Border>

          <!-- Two-way choices. A chip carries its SUBJECT and its VALUE, because
               "world" is not the enabled state of "local" and a box containing
               only the word "Studio" is a word with nothing to attach it to. -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="chip" Click="OnOrientationClicked"
                    ToolTip.Tip="Which axes a drag resolves against.  X">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chipsubject" Text="Axes" />
                <TextBlock Classes="chipvalue" Text="{Binding Orientation}" />
              </StackPanel>
            </Button>
            <Button Classes="chip" Click="OnStyleClicked"
                    ToolTip.Tip="Studio puts a handle on every face and anchors a resize to the opposite one. Classic puts three handles on the pivot and resizes about it.  Y">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chipsubject" Text="Handles" />
                <TextBlock Classes="chipvalue" Text="{Binding GizmoStyle}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Width="26" Padding="0" Click="OnUndoClicked"
                      IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}">
                <Path Classes="icon" Data="{StaticResource IconUndo}" />
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Width="26" Padding="0" Click="OnRedoClicked"
                      IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}">
                <Path Classes="icon" Data="{StaticResource IconRedo}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Insert. On the ONE command row, and first among equals for a new
               user: this is the group that answers "how do I put something in
               the world", and it used to live on a tab that opened to a
               different set of buttons. Each lands on the surface at the centre
               of the view, snapped to the grid, selected, one undo entry. -->
          <Border Classes="cluster">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Click="OnInsertWorldBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Solid geometry. Merges with the rest of the level and can be cut.  Ctrl+1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-world" Data="{StaticResource IconBrushWorld}" />
                  <TextBlock Text="Block" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertPartBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Moves and animates freely, and never merges. Use it for anything that has to move.  Ctrl+2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-part" Data="{StaticResource IconBrushPart}" />
                  <TextBlock Text="Part" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertSubtractiveBrushClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="Carves a hole out of the blocks it overlaps. Doorways and windows.  Ctrl+3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-cut" Data="{StaticResource IconBrushSubtractive}" />
                  <TextBlock Text="Cut" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Click="OnInsertLightClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="A point light.  Ctrl+4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon kind-light" Data="{StaticResource IconLight}" />
                  <TextBlock Text="Light" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="tool" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Frame the selection.  F">
            <Path Classes="icon" Data="{StaticResource IconFrame}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Start page | editor ================
         Two states of one row. The start page shows while NO engine session
         exists, which for a native session is the only time free layout is
         possible at all: its child window is created when the session launches
         and composites above anything Avalonia draws from then on. The code
         behind switches the two explicitly, because the viewport must leave the
         tree BEFORE the editor view hides, never after. -->
    <Panel Grid.Row="2">

      <shell:StartPage x:Name="StartView" />

      <!-- ============ Panels | viewport ================
           DOCKED, all of it, and the cells below are the NATIVE session's
           shape: every panel owns its own and none of them intersects the
           viewport's, because a NativeControlHost's child composites above
           anything Avalonia draws in this window. A composited session lifts
           the viewport out of its cell into the fourth dock and that
           constraint stops applying, which is the only thing about this grid
           that varies. -->
      <!-- THE ROWS ARE NEW, AND THEIR ABSENCE IS WHY NOTHING HORIZONTAL HAD A
           HOME. This grid was columns-only, so a content browser, an output log
           and a console had nowhere to be but a fourth vertical column - which
           is the shape that makes an editor read as a web dashboard. Left and
           right span the full height, because the tree and the inspector are
           the two panels that genuinely want it; the bottom region takes the
           centre column only, under the viewport, which is Godot's shape and
           the right one here. -->
      <Grid x:Name="EditorView" IsVisible="False">

        <!-- Spelled out rather than written as a string, because MIN sizes have
             no shorthand and the panels had none: the viewport was clamped at
             360 from the day it was embedded, while the columns beside it could
             be dragged to zero width and left there, with the only way back
             being a splitter one pixel from the window edge. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="288" MinWidth="180" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" MinWidth="360" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="308" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="1" />
          <RowDefinition Height="236" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Four DockControls now: one per side, one under the centre column,
             and one IN the centre cell, which only a composited session ever
             shows. The panels have always docked, re-stacked, tabbed and
             floated (a floated panel is a real OS window, which is exactly why
             it may cross a native viewport). What changed is the viewport: it
             stays PINNED for a native session, because a NativeControlHost's
             HWND is destroyed by any re-parent and the engine session goes with
             it, and joins them for a composited one, which has no window to
             destroy. -->
        <dock:DockControl x:Name="LeftDock" Grid.Column="0" Grid.RowSpan="3"
                          InitializeLayout="True" InitializeFactory="True">
          <!-- Native floats, never the managed in-window layer, on every root
               and in both placements. Beside a native child it is the only
               thing that works at all: a managed float is drawn in THIS
               window's Avalonia layer, which the child composites over, so the
               float would be invisible exactly where people drop panels.
               Beside a composited pane it is merely a z-order question, and it
               is still the right answer - a panel dragged out of the window
               belongs to the desktop, not to a rectangle inside the editor. -->
          <dm:RootDock x:Name="LeftRoot" Id="LeftRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #LeftLayout}">
            <dm:ProportionalDock x:Name="LeftLayout" Id="LeftLayout" Orientation="Vertical">
              <!-- The tools' CONTENT is assigned in code, deliberately: XAML
                   element content of a Tool compiles to a deferred template
                   that builds fresh controls per layout change, while a
                   Control assigned to Tool.Content is returned as-is by the
                   dock's builder - one live, event-wired panel instance that
                   survives every re-dock and float. -->
              <!-- 0.11, down from 0.16: a project has one or two levels for
                   most of its life, and the pane was spending a seventh of the
                   tallest column in the window on a single 24px row while the
                   scene tree below it scrolled 253 nodes. CanPin is WRITTEN
                   FROM CODE on every tool in this window, because it is the
                   airspace rule wearing another name: Dock's pinned flyout is
                   drawn in the managed Avalonia layer, so beside a native child
                   unpinning a pane makes it invisible the moment it crosses the
                   viewport and the most inviting glyph in the header is a trap.
                   Beside a composited pane the flyout draws correctly, so it
                   comes back. -->
              <dm:ToolDock Id="MapsDock" Alignment="Top" Proportion="0.085">
                <dm:Tool x:Name="MapsTool" Id="Maps" Title="Levels" CanClose="False" CanPin="False" />
              </dm:ToolDock>
              <dm:ProportionalDockSplitter />
              <dm:ToolDock Id="SceneDock" Alignment="Left" Proportion="0.89">
                <dm:Tool x:Name="SceneTool" Id="Scene" Title="Scene" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>

        <!-- The splitter's ink is one pixel; its HIT AREA is nine, which is
             what makes it draggable by a hand rather than by a surgeon. The
             ink is the column beside it.

             AND THE TRANSPARENT FILL NOW COMES FROM THE STYLE. Setting it here
             wrote a LocalValue, which outranks a StyleTrigger, so the
             GridSplitter:pointerover rule in Controls.axaml never fired on
             either of the two controls in this window a user drags most. The
             ink carries the hover instead, driven from code because a child
             cannot read its parent's pseudo-classes from a selector. -->
        <!-- The overhang leans AWAY from the viewport: the native child eats
             the mouse, so any part of the band over its cell can never
             hit-test - a symmetric -4 margin made the grab area 5px, not 9,
             exactly while a session was live. Drag events hold the ink hot,
             because a fast drag leaves the band mid-gesture. -->
        <GridSplitter Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" Cursor="SizeWestEast"
                      Width="9" Margin="-7,0,-1,0" PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #LeftSplitInk}" />
        <Border x:Name="LeftSplitInk" Grid.Column="1" Grid.RowSpan="3" Width="1" Classes="splitink"
                HorizontalAlignment="Center" />

        <!-- ============ The viewport's two homes ===========
             The pane below lives in ONE of them per session, and which one is
             a consequence of which viewport the session got rather than a
             preference.

             PINNED is this grid cell, and it is today's shape unchanged. A
             NativeControlHost's child window is destroyed by any re-parent and
             the engine session goes with it, so a native viewport sits in a
             cell nothing can dock and the airspace rule binds this window:
             nothing Avalonia draws may cross it.

             DOCKED is the DockControl below. A composited pane is an ordinary
             control over a CompositionSurfaceVisual - there is no window to
             destroy - so it docks, tabs and floats like every other panel, and
             airspace stops applying to this window entirely.

             ViewportLayout.For decides, off the SAME decision that built the
             viewport and never a second guess: the way a disagreement presents
             is a native child dragged into a tool, which destroys the HWND and
             takes the session with it.

             The fourth dock is on the SAME factory as the other three, for the
             reason written on the third: a per-control factory makes a drag's
             target list that factory's own controls, so a panel could never
             cross between regions - silently. Hidden until a composited session
             asks for it. -->
        <dock:DockControl x:Name="CenterDock" Grid.Column="2" Grid.Row="0" IsVisible="False"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="CenterRoot" Id="CenterRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #CenterLayout}">
            <dm:ProportionalDock x:Name="CenterLayout" Id="CenterLayout" Orientation="Vertical">
              <dm:ToolDock Id="ViewportDock" Alignment="Top" Proportion="1">
                <!-- CanClose stays false in both placements: there is no Window
                     menu and no reopen verb, so a closed viewport is a session
                     with a running engine and no way to see it. CanPin is
                     written from code, because it is the airspace rule wearing
                     another name - Dock draws a pinned flyout in the main
                     window's own Avalonia layer, which a native child
                     composites over. -->
                <dm:Tool x:Name="ViewportTool" Id="Viewport" Title="Viewport" CanClose="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>

        <!-- The pane itself: the header strip and the bezel, ONE control that
             travels between the two homes together, still in this cell for a
             native session and lifted out of it into the tool for a composited
             one. The header goes WITH it rather than staying behind, because a
             float that left the camera readout and the overlay chips in the
             main window would leave them describing a viewport that is
             somewhere else.

             The bezel is the darkest surface in the window and the only place
             allowed near-black: chrome, then bezel, then render, so the picture
             is framed rather than butted straight against a panel. -->
        <Grid x:Name="ViewportPane" Grid.Column="2" Grid.Row="0" RowDefinitions="Auto,*">

          <!-- ============ Viewport header ==================
               View-scoped state ABOVE the picture - the strip every engine
               editor puts here, and the one row the airspace rule never
               blocked even when it bound: chrome BESIDE a native child shrinks
               it, it does not cross it, which is why this strip could ship
               while an overlay could not. Beside a composited pane nothing
               about it needs to change, which is the point - it was built to
               the constraint rather than around it, so it is still simply the
               row above the picture and it travels with the pane into a float.
               Everything on it wires to a verb or snapshot field that already
               existed; nothing here is decoration. -->
          <Border Grid.Row="0" Height="28"
                  Background="{StaticResource SpectraBgApp}"
                  BorderBrush="{StaticResource SpectraBorderStrong}"
                  BorderThickness="0,0,0,1"
                  Padding="8,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Which pipeline is drawing, ON the view it draws. The only
                     passive display used to live in the inspector's EMPTY
                     state, so it vanished the moment anything was selected.
                     The two-way binding and its snapshot guard already
                     existed; the View menu radio stays as the second route. -->
                <ComboBox Width="106" Height="22" MinHeight="22" Padding="8,0"
                          FontSize="{StaticResource SpectraFontSmall}"
                          ItemsSource="{Binding PipelineNames}"
                          SelectedItem="{Binding PipelineName}"
                          ToolTip.Tip="Rendering pipeline" />
                <Button Classes="chip" Height="22"
                        ToolTip.Tip="When the ground grid shows. Auto means during move and resize.">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="During move and resize" ToggleType="Radio"
                                IsChecked="{Binding GridAuto, Mode=OneWay}" Click="OnGridAutoClicked" />
                      <MenuItem Header="Always" ToggleType="Radio"
                                IsChecked="{Binding GridOn, Mode=OneWay}" Click="OnGridOnClicked" />
                      <MenuItem Header="Off" ToggleType="Radio"
                                IsChecked="{Binding GridOff, Mode=OneWay}" Click="OnGridOffClicked" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="chipsubject" Text="Grid" />
                    <TextBlock Classes="chipvalue" Text="{Binding GridModeLabel}" />
                  </StackPanel>
                </Button>
                <Button Classes="chip" Height="22" Click="OnToggleNavigationClicked"
                        ToolTip.Tip="Which camera drives the viewport.  F7">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="chipsubject" Text="Camera" />
                    <TextBlock Classes="chipvalue" Text="{Binding Navigation}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="overlaychip" IsVisible="{Binding DebugWireframe}" Click="OnDebugWireClicked"
                        ToolTip.Tip="Wireframe overlay is on. Click to turn it off.  F1">
                  <TextBlock Text="wire" />
                </Button>
                <Button Classes="overlaychip" IsVisible="{Binding DebugVertices}" Click="OnDebugVerticesClicked"
                        ToolTip.Tip="CSG vertex markers are on. Click to turn them off.  F2">
                  <TextBlock Text="verts" />
                </Button>
                <Button Classes="overlaychip" IsVisible="{Binding DebugAabbs}" Click="OnDebugAabbsClicked"
                        ToolTip.Tip="Bounds overlay is on. Click to turn it off.  F3">
                  <TextBlock Text="bounds" />
                </Button>
                <Button Classes="overlaychip" IsVisible="{Binding DebugNormals}" Click="OnDebugNormalsClicked"
                        ToolTip.Tip="Face normals are on. Click to turn them off.  F4">
                  <TextBlock Text="normals" />
                </Button>
                <Button Classes="overlaychip" IsVisible="{Binding DebugSceneGraph}" Click="OnDebugSceneGraphClicked"
                        ToolTip.Tip="Node axes are on. Click to turn them off.  F5">
                  <TextBlock Text="axes" />
                </Button>
                <!-- Where am I: the one instrument every engine editor's
                     status surface carries. Mono, fixed width, one decimal,
                     so it reads as an instrument and never jitters. -->
                <TextBlock Classes="value" Foreground="{StaticResource SpectraTextMuted}"
                           Text="{Binding CameraPositionLabel}" MinWidth="132"
                           TextAlignment="Right" Margin="6,0,0,0"
                           ToolTip.Tip="Camera position, in world units" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Padding is what makes the bezel EXIST: a Border's background
               shows only through its padding ring, and with none the
               documented chrome-bezel-render framing painted zero pixels. The
               ring is beside the native child, never over it.

               MinWidth is not cosmetic either: dragging a splitter to zero can
               leave the swap chain unable to recover, and a floated pane has no
               column MinWidth behind it at all. -->
          <Border Grid.Row="1" MinWidth="360" Padding="2"
                  Background="{StaticResource SpectraViewportBezel}">
            <!-- A Grid rather than the Border's own Child, and that is the
                 whole structural cost of H12: the pane now holds the viewport
                 AND something drawn on top of it. The viewport control is
                 inserted at index 0 from code, which pushes the overlay to the
                 back of the list and therefore to the FRONT of the z order -
                 later children draw over earlier ones. Declaring the overlay
                 second in the markup would look tidier and break the moment
                 the viewport is inserted, silently, by putting the frame
                 behind the picture.

                 INSIDE the padding ring, so the bezel stays a bezel: the
                 overlay frames the render, not the chrome around it. -->
            <Grid x:Name="ViewportHost">
              <Border Classes="dropoverlay" Classes.shown="{Binding DropVisible}">
                <!-- TOP, not centred. The cursor is somewhere in this rectangle
                     carrying the drag, and the surface people aim a prop at is
                     below the horizon in almost every editor view; a chip in
                     the middle would sit on the drop point it is describing.
                     Under the header strip it reads as an extension of the
                     chrome directly above it instead. -->
                <Border Classes="dropchip" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="0,16,0,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- Two glyphs with one visible, rather than a converter:
                           the icon is half of how the accepting and refusing
                           arms are told apart, since they share a hue by
                           design. A mesh is what would land; a warning is what
                           the palette means by the same amber when nothing
                           will. -->
                      <Path Classes="icon dropicon" Data="{StaticResource IconMesh}"
                            IsVisible="{Binding DropAccepts}" />
                      <Path Classes="icon dropicon" Data="{StaticResource IconWarning}"
                            IsVisible="{Binding !DropAccepts}" />
                      <TextBlock Classes="dropheadline" Text="{Binding DropHeadline}" />
                      <TextBlock Classes="dropsubject" Text="{Binding DropSubject}"
                                 IsVisible="{Binding DropAccepts}" />
                    </StackPanel>
                    <!-- The refusal, verbatim from AssetDropPolicy. H11 chose a
                         sentence over a "no entry" cursor on the reasoning that
                         a refusal cursor says the shell did not understand the
                         gesture when in fact it understood it perfectly; this
                         is where that sentence finally sits, at the place the
                         gesture is happening rather than in the status bar
                         behind the pointer. -->
                    <TextBlock Classes="dropreason" Text="{Binding DropReason}"
                               IsVisible="{Binding !DropAccepts}" />
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- The bottom region's own splitter. Rows, not columns, and it carries
             the same ink-plus-hit-area treatment as the vertical pair. -->
        <GridSplitter Grid.Column="2" Grid.Row="1" ResizeDirection="Rows" Cursor="SizeNorthSouth"
                      Height="9" Margin="0,-1,0,-7" PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #BottomSplitInk}" />
        <Border x:Name="BottomSplitInk" Grid.Column="2" Grid.Row="1" Height="1" Classes="splitink"
                VerticalAlignment="Center" />

        <!-- The third dock, on the SAME factory as the other two. A per-control
             factory would make a drag's target list that factory's own controls,
             so a panel could never cross between regions - silently. -->
        <dock:DockControl x:Name="BottomDock" Grid.Column="2" Grid.Row="2"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="BottomRoot" Id="BottomRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #BottomLayout}">
            <dm:ProportionalDock x:Name="BottomLayout" Id="BottomLayout" Orientation="Horizontal">
              <dm:ToolDock Id="BottomToolDock" Alignment="Top" Proportion="1">
                <dm:Tool x:Name="ContentTool" Id="Content" Title="Content" CanClose="True" CanPin="False" />
                <dm:Tool x:Name="OutputTool" Id="Output" Title="Output" CanClose="True" CanPin="False" />
                <dm:Tool x:Name="ConsoleTool" Id="Console" Title="Console" CanClose="True" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>

        <GridSplitter Grid.Column="3" Grid.RowSpan="3" ResizeDirection="Columns" Cursor="SizeWestEast"
                      Width="9" Margin="-1,0,-7,0" PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #RightSplitInk}" />
        <Border x:Name="RightSplitInk" Grid.Column="3" Grid.RowSpan="3" Width="1" Classes="splitink"
                HorizontalAlignment="Center" />

        <dock:DockControl x:Name="RightDock" Grid.Column="4" Grid.RowSpan="3"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="RightRoot" Id="RightRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #RightLayout}">
            <dm:ProportionalDock x:Name="RightLayout" Id="RightLayout" Orientation="Vertical">
              <dm:ToolDock Id="PropertiesDock" Alignment="Right" Proportion="1">
                <dm:Tool x:Name="PropertiesTool" Id="Properties" Title="Properties" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
      </Grid>
    </Panel>

    <!-- ============ Status bar =========================
         Left is the message zone, which the pump never overwrites. Right is
         the continuous cluster: every field is LABELLED, because "858x804" and
         "editor freelook" beside each other in monospace is a log line, not a
         status bar, and each is fixed-width so nothing jitters. -->
    <Border Grid.Row="3"
            Height="{StaticResource SpectraStatusBarHeight}"
            Background="{StaticResource SpectraBgApp}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- RenderTransform none: the icon class scales every glyph 1.2x for
               row use, which turned this explicitly-sized 13px glyph into a
               ~15.6px one overhanging its own layout box. -->
          <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconWarning}"
                Stroke="{StaticResource SpectraAccent}" StrokeThickness="1.3"
                Stretch="Uniform" RenderTransform="none" IsVisible="{Binding IsError}" />
          <TextBlock Classes="statusmsg" Classes.errormsg="{Binding IsError}"
                     Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasSession}">
          <!-- A STANDING failure, in its own slot so nothing can overwrite it.
               A brush whose placement stopped being rigid makes every later
               compile defective, and the only symptom is that editing the level
               no longer changes what you see. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasWorldDefect}"
                      ToolTip.Tip="{Binding WorldDefectTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  RenderTransform="none"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="level not rebuilding"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>

          <!-- The graphics detector, standing beside the world defect and for
               the same reason. What the validation layer reports - a missing
               barrier, a pipeline state bound to a format it was not compiled
               for - still renders a picture, so the viewport cannot show it and
               the message line would lose it to the next thing that happens. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasDebugLayerErrors}"
                      ToolTip.Tip="{Binding DebugLayerTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  RenderTransform="none"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="{Binding DebugLayerLabel}"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>

          <!-- Play mode's standing chip, in the standing-state area beside the
               world-defect slot: a session someone is walking through must say
               so somewhere that does not scroll away. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding IsPlaying}">
            <Border Width="6" Height="6" CornerRadius="3"
                    Background="{StaticResource SpectraMode}" VerticalAlignment="Center" />
            <TextBlock Classes="value" Text="playing, F8 stops"
                       Foreground="{StaticResource SpectraMode}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>
          <TextBlock Classes="value" Text="{Binding SelectionLabel}" MinWidth="104"
                     Foreground="{StaticResource SpectraTextEmphasis}" />
          <Border Classes="groupsep" />
          <TextBlock Classes="label" Text="camera" Margin="0,0,6,0" />
          <TextBlock Classes="value" Text="{Binding Navigation}" MinWidth="96"
                     ToolTip.Tip="Which camera drives the viewport  (F7)" />
          <Border Classes="groupsep" />
          <TextBlock Classes="value" Text="{Binding NodeCountLabel}"
                     Foreground="{StaticResource SpectraTextMuted}" MinWidth="70"
                     ToolTip.Tip="Nodes in the scene" />
          <Border Classes="groupsep" />
          <!-- The engine's heartbeat: this ticks while a drag recompiles the
               level underneath the cursor, which is the cheapest honest proof
               there is a compiler under the picture. -->
          <TextBlock Classes="label" Text="compiles" Margin="0,0,6,0" />
          <TextBlock Classes="value" Text="{Binding CompileCount}"
                     Foreground="{StaticResource SpectraTextMuted}" MinWidth="40"
                     ToolTip.Tip="Static-world recompiles this session" />
          <Border Classes="groupsep" />
          <TextBlock Classes="label" Text="viewport" Margin="0,0,6,0" />
          <TextBlock Classes="value" Text="{Binding ViewportLabel}"
                     Foreground="{StaticResource SpectraTextMuted}" MinWidth="66" />
          <Border Classes="groupsep" />
          <TextBlock Classes="value frametime" Classes.overbudget="{Binding FrameTimeOverBudget}"
                     Text="{Binding FpsLabel}" MinWidth="58"
                     ToolTip.Tip="{Binding FrameTimeLabel}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
