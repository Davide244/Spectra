<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Inline geometry, not a font and not image files. An icon font is one more
    asset to ship, to fall back from and to get wrong at 125% DPI; these are a
    dozen path strings that scale exactly and tint with a brush.

    All authored in a 16x16 box so one Viewbox setting works everywhere, and all
    STROKED rather than filled, so a single 1.5px stroke weight keeps them
    optically consistent. Mixing filled and stroked glyphs in one row is the
    fastest way to make a toolbar look assembled from three sources.
  -->

  <!-- ─── Node kinds ───────────────────────────────────────
       Each says what the thing IS at 16px, which rules out detail: a cube reads
       as a cube, a bulb as a bulb, and anything finer becomes noise. -->

  <!-- A folder, for a node that is only a parent. -->
  <StreamGeometry x:Key="IconGroup">M2,4 L6.5,4 L8,5.8 L14,5.8 L14,12.5 L2,12.5 Z</StreamGeometry>

  <!-- A triangle mesh: a shape with its wireframe showing. -->
  <StreamGeometry x:Key="IconMesh">M8,2 L14,5.5 L14,11.5 L8,14.5 L2,11.5 L2,5.5 Z M8,2 L8,8.2 M8,8.2 L2,11.5 M8,8.2 L14,11.5</StreamGeometry>

  <!-- A world brush: a solid box, drawn closed. -->
  <StreamGeometry x:Key="IconBrushWorld">M2.5,5 L8,2.2 L13.5,5 L13.5,11 L8,13.8 L2.5,11 Z M2.5,5 L8,7.8 L13.5,5 M8,7.8 L8,13.8</StreamGeometry>

  <!-- A part brush: the same box, dashed, because it stays out of the carve. -->
  <StreamGeometry x:Key="IconBrushPart">M2.5,5 L8,2.2 L13.5,5 M13.5,5 L13.5,11 M13.5,11 L8,13.8 M8,13.8 L2.5,11 M2.5,11 L2.5,5 M8,7.8 L8,13.8</StreamGeometry>

  <!-- A subtractive brush: a box with a bite taken out of it. -->
  <StreamGeometry x:Key="IconBrushSubtractive">M2.5,5 L8,2.2 L13.5,5 L13.5,11 L8,13.8 L2.5,11 Z M5.5,8 L10.5,8</StreamGeometry>

  <!-- A light: a bulb with a base. -->
  <StreamGeometry x:Key="IconLight">M8,2.2 A4,4 0 0 1 10.4,9.4 L10.4,11.2 L5.6,11.2 L5.6,9.4 A4,4 0 0 1 8,2.2 Z M6.4,13.2 L9.6,13.2</StreamGeometry>

  <!-- Nothing at all: an empty transform. -->
  <StreamGeometry x:Key="IconEmpty">M8,3.5 L8,12.5 M3.5,8 L12.5,8</StreamGeometry>

  <!-- ─── Tools ────────────────────────────────────────────
       Move is a four-way arrow, rotate an arc with a head, resize a corner
       handle: the same three shapes every 3D tool has used for thirty years,
       and not a place to be original. -->
  <StreamGeometry x:Key="IconMove">M8,2 L8,14 M2,8 L14,8 M8,2 L6,4 M8,2 L10,4 M8,14 L6,12 M8,14 L10,12 M2,8 L4,6 M2,8 L4,10 M14,8 L12,6 M14,8 L12,10</StreamGeometry>
  <StreamGeometry x:Key="IconRotate">M13,8 A5,5 0 1 1 8,3 M8,3 L5.6,1.4 M8,3 L5.6,4.8</StreamGeometry>
  <StreamGeometry x:Key="IconResize">M3,3 L3,9 M3,3 L9,3 M3,3 L9,9 M13,13 L13,7 M13,13 L7,13</StreamGeometry>

  <!-- ─── Modes ────────────────────────────────────────────
       World is a globe, local is a set of axes: the distinction is "the
       world's frame" versus "the object's own", so the icons say exactly that. -->
  <StreamGeometry x:Key="IconWorld">M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M2,8 L14,8 M8,2 A7.5,7.5 0 0 1 8,14 M8,2 A7.5,7.5 0 0 0 8,14</StreamGeometry>
  <StreamGeometry x:Key="IconLocal">M4,12 L4,4 M4,12 L12,12 M4,12 L9.5,6.5</StreamGeometry>

  <!-- A magnet, poles DOWN. A horseshoe drawn the other way up reads as a
       shield, which is a different affordance entirely. -->
  <StreamGeometry x:Key="IconSnap">M3.5,13 L3.5,7.5 A4.5,4.5 0 0 1 12.5,7.5 L12.5,13 M3.5,10 L7,10 M9,10 L12.5,10 M3.5,13 L7,13 M9,13 L12.5,13</StreamGeometry>

  <!-- ─── History and structure ────────────────────────────-->
  <StreamGeometry x:Key="IconUndo">M6,5 L3,8 L6,11 M3,8 L10,8 A3.5,3.5 0 0 1 10,15 L7,15</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M10,5 L13,8 L10,11 M13,8 L6,8 A3.5,3.5 0 0 0 6,15 L9,15</StreamGeometry>
  <StreamGeometry x:Key="IconDuplicate">M5.5,2.5 L13.5,2.5 L13.5,10.5 M2.5,5.5 L10.5,5.5 L10.5,13.5 L2.5,13.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDelete">M3,4.5 L13,4.5 M6.5,4.5 L6.5,2.5 L9.5,2.5 L9.5,4.5 M4.5,4.5 L5.2,13.5 L10.8,13.5 L11.5,4.5</StreamGeometry>
  <StreamGeometry x:Key="IconGroupNodes">M2.5,2.5 L6,2.5 M2.5,2.5 L2.5,6 M13.5,2.5 L10,2.5 M13.5,2.5 L13.5,6 M2.5,13.5 L6,13.5 M2.5,13.5 L2.5,10 M13.5,13.5 L10,13.5 M13.5,13.5 L13.5,10 M6,6 L10,6 L10,10 L6,10 Z</StreamGeometry>
  <StreamGeometry x:Key="IconUngroupNodes">M2.5,2.5 L6,2.5 M2.5,2.5 L2.5,6 M13.5,13.5 L10,13.5 M13.5,13.5 L13.5,10 M3,8.5 L13,8.5</StreamGeometry>

  <!-- Frame the selection: a viewfinder closing on a point. -->
  <StreamGeometry x:Key="IconFrame">M2.5,5.5 L2.5,2.5 L5.5,2.5 M10.5,2.5 L13.5,2.5 L13.5,5.5 M13.5,10.5 L13.5,13.5 L10.5,13.5 M5.5,13.5 L2.5,13.5 L2.5,10.5 M8,6.5 A1.5,1.5 0 1 0 8,9.5 A1.5,1.5 0 1 0 8,6.5</StreamGeometry>

  <!-- The expander. Drawn pointing right and rotated 90 degrees when open, so
       one geometry covers both states and they cannot drift in weight. -->
  <StreamGeometry x:Key="IconChevronRight">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>

  <StreamGeometry x:Key="IconSearch">M7,2.5 A4.5,4.5 0 1 0 7,11.5 A4.5,4.5 0 1 0 7,2.5 M10.5,10.5 L14,14</StreamGeometry>
  <StreamGeometry x:Key="IconClear">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>

  <!-- ─── Play mode ────────────────────────────────────────
       The universal pair, stroked like everything else here. -->
  <StreamGeometry x:Key="IconPlay">M5.5,3.5 L12.5,8 L5.5,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M4.5,4.5 L11.5,4.5 L11.5,11.5 L4.5,11.5 Z</StreamGeometry>

  <!-- ─── Start page ───────────────────────────────────────
       A folder with a plus, a plain open folder, and a folded map: the three
       doors into the editor, drawn at the same weight as the toolbar set. -->
  <StreamGeometry x:Key="IconNewProject">M2,12.5 L2,3.5 L6.5,3.5 L8,5.5 L14,5.5 L14,12.5 Z M8,7.5 L8,11 M6.25,9.25 L9.75,9.25</StreamGeometry>
  <StreamGeometry x:Key="IconOpenFolder">M2,12.5 L2,3.5 L6.5,3.5 L8,5.5 L14,5.5 L14,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMap">M2,4 L6,2.5 L10,4.5 L14,3 L14,12 L10,13.5 L6,11.5 L2,13 Z M6,2.5 L6,11.5 M10,4.5 L10,13.5</StreamGeometry>

</ResourceDictionary>
