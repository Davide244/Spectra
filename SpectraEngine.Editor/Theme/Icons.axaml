<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Inline geometry, not a font and not image files. An icon font is one more
    asset to ship, to fall back from and to get wrong at 125% DPI; these are a
    dozen path strings that scale exactly and tint with a brush.

    TWO RULES, AND THE FIRST ONE USED TO BE BROKEN IN A WAY NOBODY COULD SEE.

    1. EVERY GLYPH'S INK FILLS THE SAME BOX: 2.5 to 13.5 on both axes, centred
       on (8,8). This file always claimed the glyphs shared a 16x16 grid, and
       they did - but `Path` was drawing them with `Stretch="Uniform"`, which
       normalises each geometry to ITS OWN ink bounds and throws the shared grid
       away. A glyph whose ink measured 9 units rendered 1.33x, one measuring 7
       rendered 1.78x, and the play triangle grew 29% when it became the stop
       square. Eleven unlabelled outlines at four different optical sizes are
       not eleven icons, they are a grey texture, which is exactly what the
       toolbar had become. The style now draws with `Stretch="None"` so the
       authored coordinates ARE the rendered ones - and the geometries below are
       normalised as well, so the row survives either setting.

    2. KINDS ARE TOLD APART BY SILHOUETTE, NEVER BY INTERIOR STROKES. At 16px
       with a 1.5 stroke, two shapes with the same outline and different insides
       are the same shape. The three brush kinds used to be exactly that; they
       are now a cube on the ground (block: fused into the level), a free cube
       (part), and a cube with a hole through it (cut).

    All stroked at 1.5 with round caps and joins, except the play/stop pair,
    which is filled because that pair is filled everywhere in the world - and
    whose two glyphs are drawn to the same optical area so the button does not
    change weight when a run starts.
  -->

  <!-- ___ Node kinds ______________________________________
       Each says what the thing IS at 16px, which rules out detail: a cube reads
       as a cube, a bulb as a bulb, and anything finer becomes noise. -->

  <!-- A folder, for a node that is only a parent. -->
  <StreamGeometry x:Key="IconGroup">M2.5,12.5 L2.5,3.5 L6.5,3.5 L8,5.5 L13.5,5.5 L13.5,12.5 Z</StreamGeometry>

  <!-- A mesh prop: a wireframed sphere. Deliberately ROUND, because the three
       brush kinds below are all cubes and a fourth cube would be a fourth
       identical silhouette. -->
  <StreamGeometry x:Key="IconMesh">M8,2.5 A5.5,5.5 0 1 1 7.99,2.5 Z M2.5,8 L13.5,8 M8,2.5 A2.6,5.5 0 0 0 8,13.5 M8,2.5 A2.6,5.5 0 0 1 8,13.5</StreamGeometry>

  <!-- A block: a cube resting on the ground line it fuses into. The baseline is
       the whole distinction from a part, and it is on the silhouette. -->
  <StreamGeometry x:Key="IconBrushWorld">M3,5.4 L8,2.6 L13,5.4 L13,10 L8,12.8 L3,10 Z M3,5.4 L8,8.2 L13,5.4 M8,8.2 L8,12.8 M2.5,13.5 L13.5,13.5</StreamGeometry>

  <!-- A part: the same cube, free of the ground, because it stays out of the
       carve and moves as it likes. -->
  <StreamGeometry x:Key="IconBrushPart">M3,6.2 L8,3.4 L13,6.2 L13,10.8 L8,13.6 L3,10.8 Z M3,6.2 L8,9 L13,6.2 M8,9 L8,13.6</StreamGeometry>

  <!-- A cut: a cube with a hole through it. The hole is in the outline, not a
       line across the middle. -->
  <StreamGeometry x:Key="IconBrushSubtractive">M3,6.2 L8,3.4 L13,6.2 L13,10.8 L8,13.6 L3,10.8 Z M8,7.6 A2.1,2.3 0 1 1 7.99,7.6 Z</StreamGeometry>

  <!-- A light: a bulb over its base. -->
  <StreamGeometry x:Key="IconLight">M8,2.5 A4.2,4.2 0 1 1 7.99,2.5 Z M5.8,11.6 L10.2,11.6 M6.5,13.5 L9.5,13.5</StreamGeometry>

  <!-- An entity: a diamond. Deliberately the only glyph in the set that is not
       a cube, a sphere, a folder, a bulb or a cross - an entity has no shape of
       its own to draw, so the mark has to be an abstract one, and a diamond is
       what every level editor since Quake has used for a point entity. It is
       told apart by silhouette alone, which is the rule: no dot, no wire stub,
       nothing inside it. -->
  <StreamGeometry x:Key="IconEntity">M8,2.5 L13.5,8 L8,13.5 L2.5,8 Z</StreamGeometry>

  <!-- Nothing at all: an empty transform. -->
  <StreamGeometry x:Key="IconEmpty">M8,2.5 L8,13.5 M2.5,8 L13.5,8</StreamGeometry>

  <!-- ___ Tools ___________________________________________
       Move is a four-way arrow, rotate an arc with a head, size a box growing
       out of its corner: the same three ideas every 3D tool has used for thirty
       years, and not a place to be original. -->
  <StreamGeometry x:Key="IconMove">M8,2.5 L8,13.5 M2.5,8 L13.5,8 M8,2.5 L5.8,4.9 M8,2.5 L10.2,4.9 M8,13.5 L5.8,11.1 M8,13.5 L10.2,11.1 M2.5,8 L4.9,5.8 M2.5,8 L4.9,10.2 M13.5,8 L11.1,5.8 M13.5,8 L11.1,10.2</StreamGeometry>
  <StreamGeometry x:Key="IconRotate">M13,8.6 A5,5 0 1 1 8,3.6 M8,3.6 L5.9,2.5 M8,3.6 L5.9,4.7</StreamGeometry>
  <StreamGeometry x:Key="IconResize">M2.5,7.5 L2.5,13.5 L8.5,13.5 L8.5,7.5 Z M7.6,8.4 L13.5,2.5 M13.5,2.5 L9.6,2.5 M13.5,2.5 L13.5,6.4</StreamGeometry>

  <!-- The snap increment's own glyph is a GRID, not a magnet. The control
       beside it holds a grid size in world units, and the horseshoe that used
       to sit here read as an arch at 16px anyway. -->
  <StreamGeometry x:Key="IconGrid">M3,3 L13,3 M3,8 L13,8 M3,13 L13,13 M3,3 L3,13 M8,3 L8,13 M13,3 L13,13</StreamGeometry>

  <!-- ___ History and structure ___________________________
       Undo and redo used to be authored from y=5 to y=15 while their
       neighbours ran 2 to 14, so they sat two pixels low in a row of otherwise
       centred glyphs. Both are on the shared box now. -->
  <StreamGeometry x:Key="IconUndo">M5.8,3.8 L2.5,7.1 L5.8,10.4 M2.5,7.1 L9.5,7.1 A3.2,3.2 0 0 1 9.5,13.5 L7.2,13.5</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M10.2,3.8 L13.5,7.1 L10.2,10.4 M13.5,7.1 L6.5,7.1 A3.2,3.2 0 0 0 6.5,13.5 L8.8,13.5</StreamGeometry>

  <StreamGeometry x:Key="IconDuplicate">M5.5,2.5 L13.5,2.5 L13.5,10.5 M2.5,5.5 L10.5,5.5 L10.5,13.5 L2.5,13.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDelete">M2.5,4.5 L13.5,4.5 M6.5,4.5 L6.5,2.5 L9.5,2.5 L9.5,4.5 M4.5,4.5 L5.2,13.5 L10.8,13.5 L11.5,4.5</StreamGeometry>

  <!-- Group collects two things behind one bracket; ungroup shows them getting
       out. The old pair was one glyph and the same glyph with strokes removed,
       which is the same silhouette twice. -->
  <StreamGeometry x:Key="IconGroupNodes">M6,3 L13.5,3 L13.5,7 L6,7 Z M6,9 L13.5,9 L13.5,13 L6,13 Z M3.5,2.5 L2.5,2.5 L2.5,13.5 L3.5,13.5</StreamGeometry>
  <StreamGeometry x:Key="IconUngroupNodes">M3.5,2.5 L2.5,2.5 L2.5,6 M2.5,10 L2.5,13.5 L3.5,13.5 M5.5,3 L11,3 L11,7 L5.5,7 Z M8,9 L13.5,9 L13.5,13 L8,13 Z</StreamGeometry>

  <!-- Converting between block and part is its OWN verb and gets its own
       glyph: two kinds, swapping. It used to borrow the part cube, so one
       drawing meant both "insert a part" and "convert to part" in one row. -->
  <StreamGeometry x:Key="IconConvertKind">M2.5,2.5 L7,2.5 L7,7 L2.5,7 Z M9,9 L13.5,9 L13.5,13.5 L9,13.5 Z M8.4,4.75 L12.6,4.75 M12.6,4.75 L10.9,3.1 M7.6,11.25 L3.4,11.25 M3.4,11.25 L5.1,12.9</StreamGeometry>

  <!-- Frame the selection: a viewfinder closing on a point. -->
  <StreamGeometry x:Key="IconFrame">M2.5,5.5 L2.5,2.5 L5.5,2.5 M10.5,2.5 L13.5,2.5 L13.5,5.5 M13.5,10.5 L13.5,13.5 L10.5,13.5 M5.5,13.5 L2.5,13.5 L2.5,10.5 M8,6.5 A1.5,1.5 0 1 0 8,9.5 A1.5,1.5 0 1 0 8,6.5</StreamGeometry>

  <!-- ___ Chrome __________________________________________
       The expander is drawn pointing right and rotated 90 degrees when open,
       so one geometry covers both states and they cannot drift in weight. -->
  <StreamGeometry x:Key="IconChevronRight">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>

  <!-- The content browser's pair. Up is a chevron plus a bar, not a bare arrow:
       a bare arrow in a path row reads as "back", and back and up are different
       journeys through a folder tree. Refresh is a three-quarter ring with one
       head, which is the shape every tool uses for it. -->
  <StreamGeometry x:Key="IconArrowUp">M8,13 L8,4.5 M4.5,8 L8,4.5 L11.5,8 M3.5,2.5 L12.5,2.5</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11,4.1 M13.5,2 L13.5,5 L10.5,5</StreamGeometry>

  <StreamGeometry x:Key="IconClear">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>

  <!-- The status bar's failure mark. The one glyph in the set allowed to carry
       the accent, because it is the one that means stop and read this. -->
  <StreamGeometry x:Key="IconWarning">M8,2.5 L13.8,13.1 L2.2,13.1 Z M8,6.4 L8,9.6 M8,11.4 L8,11.5</StreamGeometry>

  <!-- ___ Play mode _______________________________________
       The one FILLED pair, and drawn to the same optical area: a triangle of
       ~35 square units against a square of ~38, so pressing play does not make
       the glyph jump a weight. -->
  <StreamGeometry x:Key="IconPlay">M5.5,3.2 L12.8,8 L5.5,12.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M5.2,4.8 L11.2,4.8 L11.2,11.2 L5.2,11.2 Z</StreamGeometry>

  <!-- ___ Start page ______________________________________
       A folder with a plus, a plain open folder, and a folded map: the three
       doors into the editor, on the same box as the toolbar set. -->
  <StreamGeometry x:Key="IconNewProject">M2.5,12.5 L2.5,3.5 L6.5,3.5 L8,5.5 L13.5,5.5 L13.5,12.5 Z M8,7.6 L8,10.9 M6.35,9.25 L9.65,9.25</StreamGeometry>
  <StreamGeometry x:Key="IconOpenFolder">M2.5,12.5 L2.5,3.5 L6.5,3.5 L8,5.5 L13.5,5.5 L13.5,12.5 Z M5,8.5 L11,8.5</StreamGeometry>
  <StreamGeometry x:Key="IconMap">M2.5,4 L6.2,2.5 L9.8,4.6 L13.5,3.1 L13.5,12 L9.8,13.5 L6.2,11.4 L2.5,12.9 Z M6.2,2.5 L6.2,11.4 M9.8,4.6 L9.8,13.5</StreamGeometry>

</ResourceDictionary>
