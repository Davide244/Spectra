// $fileinputname$.spectrashade

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader $safeitemname$ {
    [Binding(0)] cbuffer Camera {
        mat4 viewProjection;
    }

    [Binding(1)] sampler2D mainTex;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = vec4(input.position, 1.0) * viewProjection;
        output.uv = input.uv;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        var color = mainTex.Sample(input.uv);
        return color;
    }
}
