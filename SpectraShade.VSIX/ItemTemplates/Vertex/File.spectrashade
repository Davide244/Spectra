// $fileinputname$.spectrashade
// SpectraShade vertex shader

struct VSInput
{
    float3 position;
    float3 normal;
    float2 uv;
}

struct VSOutput
{
    float4 position;
    float2 uv;
}

cbuffer Camera
{
    float4x4 viewProjection;
}

shader $safeitemname$ : vertex
{
    VSOutput main(VSInput input)
    {
        VSOutput o;
        o.position = mul(viewProjection, float4(input.position, 1.0));
        o.uv = input.uv;
        return o;
    }
}
