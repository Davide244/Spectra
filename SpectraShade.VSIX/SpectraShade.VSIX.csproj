<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- VSIX extension properties -->
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.12.8" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.12.40504" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.12.2123" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Grammars\spectrashade\spectrashade.tmLanguage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LogoSpectra.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LogoSpectra.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <VSTemplate Include="ItemTemplates\Empty\Empty.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\Vertex\Vertex.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\Fragment\Fragment.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VsSDKInstall)\Microsoft.VsSDK.targets" />

  <PropertyGroup>
    <SpectraShadeLspProject>$(MSBuildThisFileDirectory)..\SpectraShade.LSP\SpectraShade.LSP.csproj</SpectraShadeLspProject>
    <SpectraShadeLspPublishDir>$(MSBuildThisFileDirectory)..\SpectraShade.LSP\bin\$(Configuration)\net10.0\win-x64\publish\</SpectraShadeLspPublishDir>
  </PropertyGroup>

  <Target Name="PublishSpectraShadeLsp" BeforeTargets="GetVsixSourceItems">
    <Exec Command="dotnet publish &quot;$(SpectraShadeLspProject)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=false" />
  </Target>

  <Target Name="IncludeSpectraShadeLspInVsix" AfterTargets="PublishSpectraShadeLsp" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <_SpectraShadeLspFiles Include="$(SpectraShadeLspPublishDir)**\*.*" />
      <VSIXSourceItem Include="@(_SpectraShadeLspFiles)">
        <VSIXSubPath>spectrashade-lsp\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

</Project>
