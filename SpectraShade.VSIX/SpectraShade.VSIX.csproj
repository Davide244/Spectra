<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- VSIX extension properties -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.12.8" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.12.40504" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.12.2123" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Grammars\spectrashade\spectrashade.tmLanguage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LogoSpectra.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LogoSpectra.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <VSTemplate Include="ItemTemplates\Empty\Empty.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\Vertex\Vertex.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\Fragment\Fragment.vstemplate">
      <OutputSubPath>ItemTemplates\SpectraShade</OutputSubPath>
    </VSTemplate>
  </ItemGroup>

  <PropertyGroup>
    <SpectraShadeLspProject>$(MSBuildThisFileDirectory)..\SpectraShade.LSP\SpectraShade.LSP.csproj</SpectraShadeLspProject>
    <SpectraShadeLspPublishDir>$(MSBuildThisFileDirectory)..\SpectraShade.LSP\bin\$(Configuration)\net10.0\win-x64\publish\</SpectraShadeLspPublishDir>
  </PropertyGroup>

  <Target Name="PublishSpectraShadeLsp" BeforeTargets="BeforeBuild;GetVsixSourceItems">
    <Exec Command="dotnet publish &quot;$(SpectraShadeLspProject)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=false" />
  </Target>

  <Target Name="IncludeSpectraShadeLspInVsix" AfterTargets="PublishSpectraShadeLsp" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <_SpectraShadeLspFiles Include="$(SpectraShadeLspPublishDir)**\*.*" />
      <Content Include="@(_SpectraShadeLspFiles)">
        <Link>spectrashade-lsp\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>spectrashade-lsp\%(RecursiveDir)</VSIXSubPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
