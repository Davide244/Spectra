<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Roslyn, for the entity source generator (and for the tests that drive it).

      PINNED AT OR BELOW THE ROSLYN THE INSTALLED SDK HOSTS, and that is the
      whole rule. An analyzer binds against the Microsoft.CodeAnalysis the
      COMPILER loaded, not against the copy in its own package folder: a
      reference to a newer one fails to bind and Roslyn drops the analyzer
      SILENTLY, so the symptom is a missing generated type reported as an
      ordinary "type or namespace could not be found" at the consumer, nowhere
      near the cause. Measured 2026-09: SDK 10.0.201 hosts assembly version
      5.3.0.0 and SDK 10.0.100-rc.1 hosts 5.0.0.0, so 5.0.0 is the highest pin
      that runs on both. Raise it only after checking the SDKs that must build
      this repo, never to pick up a language feature.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />

    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.4" />

    <!-- Serilog (Executable host) -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!--
      Editor shell. Avalonia over Uno on the docking story (a level editor
      without dockable panes is not a level editor) and because it runs
      everywhere the engine runs. NativeControlHost is what embeds the engine's
      own surface; see ROADMAP §10.
    -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!--
      Docking. Dock.Avalonia is MIT and did NOT go the commercial route
      TreeDataGrid 12.x took (verified 2026-08: licence in repo and NuGet).
      Dock.Model.Avalonia rather than .Mvvm/.ReactiveUI, because its dockables
      carry Content directly, which is what lets the shell keep its live,
      event-wired panel controls instead of templating fresh ones per layout
      change.
    -->
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.1.0.6" />

    <!-- Language Server -->
    <PackageVersion Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />

    <!-- Image decoding (pure managed, AOT-safe: PNG/JPG/TGA/BMP) -->
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />

    <!--
      XxHash128, which keys the .spack entry table and its content digest. Not in
      the shared framework, so it is a package rather than a using. Its NativeAOT
      posture was verified rather than inferred (this repo adopts no dependency on
      an inferred one): a throwaway console calling the one-shot, incremental and
      HashToUInt128 forms published with -p:PublishAot=true on win-x64 with no
      trim or AOT warnings, ran as a 951 KB native binary, and returned the
      reference XXH3-128 vector for the empty input.
    -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />

    <!-- Testing (xunit v3 on Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="Verify.XunitV3" Version="31.16.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!-- VSIX (net472) -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.12.8" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.15.0" Version="17.12.40504" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.12.2123" />

    <!--
      Silk.NET graphics/audio/input. Only packages some project actually
      references are listed: the metapackage plus OpenCL, Vulkan and XInput
      were carried here with no consumer at all, and a version row for a
      package nobody references is an invitation to reference it by accident.
      Vulkan returns with the SPIR-V generator.
    -->
    <PackageVersion Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Direct3D12" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <!--
      The two .Glfw backends are pulled in transitively by Silk.NET.Windowing /
      Silk.NET.Input, but SilkPlatform references their RegisterPlatform types
      directly (that static reference is what survives trimming), so they are
      listed explicitly rather than relying on transitive compile-time assets.
    -->
    <PackageVersion Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!--
      The native half, and it is not optional in practice: Silk.NET.OpenAL is
      bindings only, and Windows has shipped no OpenAL runtime since 2007, so
      without this every machine that has not installed one separately opens no
      device and the engine runs in disabled mode. Its version tracks OpenAL
      Soft's own releases rather than Silk's, which is why it is 1.x beside the
      2.23.0 bindings.
    -->
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Common" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

</Project>
