<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The editing layer is referenced HERE and nowhere below: this executable is
    the engine's editor-shaped demo host, so it is the one binary allowed to
    pull gizmo/undo/tool code in. A shipped game host would simply drop this
    reference and get a build with none of it — which is the whole reason
    SpectraEngine.Editing is a separate assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
    <ProjectReference Include="..\SpectraEngine.Editing\SpectraEngine.Editing.csproj" />
    <!--
      The built-in logic entities. A host references this and calls the anchor;
      a game that wants none of them simply drops the reference, exactly as it
      would drop the editing assembly.
    -->
    <ProjectReference Include="..\SpectraEngine.Entities\SpectraEngine.Entities.csproj" />
    <ProjectReference Include="..\SpectraEngine.Physics.Box3D\SpectraEngine.Physics.Box3D.csproj" />
    <ProjectReference Include="..\SpectraShade.Compiler\SpectraShade.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
